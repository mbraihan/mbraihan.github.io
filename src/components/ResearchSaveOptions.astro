---
import { Download, FileSpreadsheet } from 'lucide-astro';

interface Props {
  sheetName: string;
}

const { sheetName } = Astro.props;
---

<div class="save-option-block">
  <span class="block-label">Data Save Option</span>
  <div class="save-cards-grid">
    <label class="save-card active" id="card-option-sheets">
      <input type="radio" name="saveOption" value="googlesheets" checked class="sr-only" />
      <span class="card-icon-box"><FileSpreadsheet size={20} aria-hidden="true" /></span>
      <span class="card-text-content">
        <span class="card-title">Google Sheets</span>
        <span class="card-desc">Append data directly to your Google Sheet</span>
      </span>
    </label>

    <label class="save-card" id="card-option-csv">
      <input type="radio" name="saveOption" value="local" class="sr-only" />
      <span class="card-icon-box"><Download size={20} aria-hidden="true" /></span>
      <span class="card-text-content">
        <span class="card-title">Download CSV</span>
        <span class="card-desc">Save responses to a local CSV file</span>
      </span>
    </label>
  </div>

  <div id="sheets-inputs-row" class="sheets-inputs-row">
    <div class="fields-grid">
      <div class="field-group">
        <label for="sheet-name">Sheet / Tab Name <span class="required">*</span></label>
        <input
          type="text"
          id="sheet-name"
          value={sheetName}
          class="form-input"
          placeholder="e.g. Sheet1 or NASA_TLX"
        />
      </div>
      <div class="field-group">
        <label for="sheet-url">Google Sheet Link <span class="required">*</span></label>
        <input
          type="url"
          id="sheet-url"
          placeholder="https://docs.google.com/spreadsheets/d/.../edit"
          class="form-input"
          aria-describedby="sheet-url-storage-note sheet-url-error"
        />
        <span id="sheet-url-error" class="field-error"></span>
      </div>
    </div>

    <details class="sheets-setup-guide">
      <summary class="guide-summary">
        <span>💡 How to connect your Google Sheet (10-second setup)</span>
      </summary>
      <div class="guide-content">
        <ol class="guide-steps">
          <li>Create or open your target Google Sheet.</li>
          <li>Click <strong>Share</strong> (top right) &rarr; under <em>General access</em>, change to <strong>Anyone with the link can edit</strong>.</li>
          <li>Copy the Google Sheet link from your browser address bar and paste it into the input box above!</li>
        </ol>
        <details class="advanced-script-guide">
          <summary class="advanced-summary">Advanced: Using a custom Google Apps Script deployment</summary>
          <div class="advanced-content">
            <p>If you prefer to deploy your own private script instead of sharing your sheet link, copy the script below, deploy it as a Web App (access: Anyone), and paste your <code>/exec</code> URL above:</p>
            <div class="script-code-box">
              <button type="button" id="copy-apps-script-btn" class="copy-script-btn">Copy Script</button>
              <pre><code>function doPost(e) &#123;
  var lock = LockService.getScriptLock();
  lock.tryLock(10000);
  try &#123;
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var data = JSON.parse(e.postData.contents);
    var rowsToAppend = [];
    var sheetName = "Sheet1";

    if (Array.isArray(data)) &#123;
      rowsToAppend = data;
    &#125; else if (data && Array.isArray(data.rows)) &#123;
      sheetName = data.sheetName || "Sheet1";
      rowsToAppend = data.rows;
    &#125; else if (data) &#123;
      sheetName = data.sheetName || "Sheet1";
      var obj = &#123;&#125;;
      for (var k in data) &#123; if (k !== 'sheetName') obj[k] = data[k]; &#125;
      rowsToAppend = [obj];
    &#125;

    if (rowsToAppend.length === 0) return ContentService.createTextOutput(JSON.stringify(&#123; success: false &#125;)).setMimeType(ContentService.MimeType.JSON);

    var sheet = ss.getSheetByName(sheetName) || ss.insertSheet(sheetName);
    var keys = Object.keys(rowsToAppend[0]);
    if (sheet.getLastRow() === 0) sheet.appendRow(keys);

    rowsToAppend.forEach(function(r) &#123;
      sheet.appendRow(keys.map(function(k) &#123; return (r[k] !== undefined && r[k] !== null) ? r[k] : ""; &#125;));
    &#125;);

    return ContentService.createTextOutput(JSON.stringify(&#123; success: true &#125;)).setMimeType(ContentService.MimeType.JSON);
  &#125; catch(err) &#123;
    return ContentService.createTextOutput(JSON.stringify(&#123; success: false, error: err.toString() &#125;)).setMimeType(ContentService.MimeType.JSON);
  &#125; finally &#123;
    lock.releaseLock();
  &#125;
&#125;</code></pre>
            </div>
          </div>
        </details>
      </div>
    </details>

    <p id="sheet-url-storage-note" class="storage-note">
      This URL is remembered only in this browser on this device.
    </p>
  </div>
</div>

<script>
  document.getElementById('copy-apps-script-btn')?.addEventListener('click', async () => {
    const code = `function doPost(e) {
  var lock = LockService.getScriptLock();
  lock.tryLock(10000);
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var data = JSON.parse(e.postData.contents);
    var rowsToAppend = [];
    var sheetName = "Sheet1";

    if (Array.isArray(data)) {
      rowsToAppend = data;
    } else if (data && Array.isArray(data.rows)) {
      sheetName = data.sheetName || "Sheet1";
      rowsToAppend = data.rows;
    } else if (data) {
      sheetName = data.sheetName || "Sheet1";
      var obj = {};
      for (var k in data) { if (k !== 'sheetName') obj[k] = data[k]; }
      rowsToAppend = [obj];
    }

    if (rowsToAppend.length === 0) return ContentService.createTextOutput(JSON.stringify({ success: false })).setMimeType(ContentService.MimeType.JSON);

    var sheet = ss.getSheetByName(sheetName) || ss.insertSheet(sheetName);
    var keys = Object.keys(rowsToAppend[0]);
    if (sheet.getLastRow() === 0) sheet.appendRow(keys);

    rowsToAppend.forEach(function(r) {
      sheet.appendRow(keys.map(function(k) { return (r[k] !== undefined && r[k] !== null) ? r[k] : ""; }));
    });

    return ContentService.createTextOutput(JSON.stringify({ success: true })).setMimeType(ContentService.MimeType.JSON);
  } catch(err) {
    return ContentService.createTextOutput(JSON.stringify({ success: false, error: err.toString() })).setMimeType(ContentService.MimeType.JSON);
  } finally {
    lock.releaseLock();
  }
}`;
    try {
      await navigator.clipboard.writeText(code);
      const btn = document.getElementById('copy-apps-script-btn');
      if (btn) {
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy Script'; }, 2000);
      }
    } catch (e) {
      console.error('Failed to copy script:', e);
    }
  });
</script>

<style>
  .save-option-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .block-label {
    color: var(--text-main);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .save-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .save-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 64px;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-pill);
    color: var(--text-main);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .save-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-1px);
  }

  .save-card.active {
    border-color: var(--accent-blue);
    background: var(--accent-blue-light);
    box-shadow: 0 0 0 1px var(--accent-blue);
  }

  .card-icon-box {
    display: inline-flex;
    color: var(--accent-blue);
  }

  .card-text-content {
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .card-desc,
  .storage-note {
    color: var(--text-subtle);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .sheets-inputs-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    color: var(--text-main);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .required {
    color: #ef4444;
  }

  .form-input {
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-pill);
    color: var(--text-main);
    font: inherit;
    font-size: 0.92rem;
    box-shadow: inset 3px 3px 6px rgba(0, 0, 0, 0.06), inset -3px -3px 6px rgba(255, 255, 255, 0.7);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global([data-theme='dark']) .form-input {
    box-shadow: inset 4px 4px 10px rgba(0, 0, 0, 0.7), inset -4px -4px 10px rgba(255, 255, 255, 0.04);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent-blue);
    background-color: var(--bg-card);
    box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.1), 0 0 0 3px rgba(37, 99, 235, 0.25), 0 0 18px rgba(37, 99, 235, 0.45);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .sheets-setup-guide {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-pill);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .guide-summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-blue);
    user-select: none;
  }

  .guide-content {
    margin-top: 0.75rem;
    font-size: 0.83rem;
    color: var(--text-main);
    line-height: 1.5;
  }

  .guide-steps {
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .advanced-script-guide {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-color);
  }

  .advanced-summary {
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-subtle);
  }

  .advanced-content {
    margin-top: 0.5rem;
  }

  .script-code-box {
    position: relative;
    margin-top: 0.4rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    overflow-x: auto;
  }

  .script-code-box pre {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.76rem;
    color: var(--text-main);
    white-space: pre-wrap;
  }

  .copy-script-btn {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: var(--bg-pill);
    color: var(--accent-blue);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .copy-script-btn:hover {
    border-color: var(--accent-blue);
    background-color: var(--accent-blue-light);
  }

  @media (max-width: 640px) {
    .save-cards-grid,
    .sheets-inputs-row {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Eye } from 'lucide-astro';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <p class="footer-copy">
      &copy;{currentYear} Mohammad Raihanul Bashar. All rights reserved.
    </p>
    <div class="footer-visitor-count" title="Total site visitors">
      <Eye size={14} class="visitor-eye-icon" />
      <span id="visitor-count" class="visitor-number">—</span>
      <span class="visitor-label"></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
    margin-top: 4rem;
    background-color: var(--bg-card);
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .footer-copy {
    margin: 0;
  }

  .footer-visitor-count {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
    background-color: var(--bg-pill);
    border: 1px solid var(--border-color);
    font-size: 0.8rem;
    color: var(--text-subtle);
    transition: all var(--transition-fast);
  }

  .visitor-eye-icon {
    color: var(--accent-blue);
    opacity: 0.8;
  }

  .visitor-number {
    font-weight: 700;
    color: var(--text-main);
    font-variant-numeric: tabular-nums;
  }

  .visitor-label {
    font-weight: 500;
  }
</style>

<script>
  async function fetchVisitorCount() {
    const countEl = document.getElementById('visitor-count');
    if (!countEl) return;

    const gcCode = (window as any).__goatcounter_code;
    if (gcCode) {
      try {
        const res = await fetch(`https://${gcCode}.goatcounter.com/counter/${encodeURIComponent('/')}.json`);
        if (res.ok) {
          const data = await res.json();
          const count = data.count_unique ?? data.count ?? 0;
          if (count > 0) {
            countEl.textContent = Number(count).toLocaleString();
            return;
          }
        }
      } catch {
        // Continue to fallback
      }
    }

    try {
      // Global real-time visitor API working across all devices and PCs
      const res = await fetch('https://api.visitorbadge.io/api/visitors?path=mbraihan-portfolio');
      if (res.ok) {
        const svgText = await res.text();
        const match = svgText.match(/VISITORS:\s*([\d,]+)/i) || svgText.match(/font-weight="bold">([\d,]+)</);
        if (match && match[1]) {
          const num = parseInt(match[1].replace(/,/g, ''), 10);
          if (!isNaN(num) && num > 0) {
            countEl.textContent = num.toLocaleString();
            return;
          }
        }
      }
    } catch (err) {
      console.error('Visitor counter error:', err);
    }

    countEl.textContent = '1+';
  }

  fetchVisitorCount();
</script>

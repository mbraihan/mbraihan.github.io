---
import { optimizeCloudinaryVideoUrl } from '../utils/media';

interface Props {
  src: string;
  className: string;
  label: string;
}

const { src, className, label } = Astro.props;
---

<video
  data-src={optimizeCloudinaryVideoUrl(src)}
  class={className}
  aria-label={label}
  data-loop-preview
  muted
  loop
  playsinline
  preload="none"
/>

<script>
  const previews = document.querySelectorAll<HTMLVideoElement>('[data-loop-preview]');
  const playbackRate = 1;

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        video.muted = true;
        video.defaultPlaybackRate = playbackRate;
        video.playbackRate = playbackRate;

        if (!video.src) {
          const source = video.dataset.src;
          if (!source) return;
          video.src = source;
          video.load();
        }

        void video.play()
          .then(() => {
            video.playbackRate = playbackRate;
          })
          .catch(() => {});
      } else {
        video.pause();
      }
    });
  }, { rootMargin: '100px 0px' });

  previews.forEach((video) => observer.observe(video));
</script>

<style>
  video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain !important;
    background-color: #000;
  }
</style>

---
import { ChevronUp } from 'lucide-astro';
---

<button
  id="scroll-to-top"
  class="scroll-to-top"
  type="button"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  title="Back to top"
>
  <svg class="scroll-progress" viewBox="0 0 56 56" aria-hidden="true">
    <circle class="scroll-progress-track" cx="28" cy="28" r="24"></circle>
    <circle
      id="scroll-progress-indicator"
      class="scroll-progress-indicator"
      cx="28"
      cy="28"
      r="24"
      pathLength="100"
    ></circle>
  </svg>
  <span class="scroll-top-icon" aria-hidden="true">
    <ChevronUp size={22} stroke-width={2.2} />
  </span>
</button>

<style>
  .scroll-to-top {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: max(1.25rem, calc(env(safe-area-inset-bottom) + 0.75rem));
    z-index: 45;
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: 50%;
    background: var(--bg-card);
    color: var(--text-main);
    box-shadow:
      0 10px 28px rgba(15, 23, 42, 0.16),
      0 2px 8px rgba(15, 23, 42, 0.12);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color var(--transition-normal),
      color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  :global([data-theme='dark']) .scroll-to-top {
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.38),
      0 2px 8px rgba(0, 0, 0, 0.28);
  }

  .scroll-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .scroll-to-top:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow:
      0 14px 32px rgba(37, 99, 235, 0.2),
      0 4px 12px rgba(15, 23, 42, 0.14);
  }

  .scroll-to-top:active {
    transform: translateY(-1px) scale(0.96);
  }

  .scroll-to-top:focus-visible {
    outline: 3px solid var(--accent-blue);
    outline-offset: 4px;
  }

  .scroll-progress {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .scroll-progress-track,
  .scroll-progress-indicator {
    fill: none;
    stroke-width: 3.5;
  }

  .scroll-progress-track {
    stroke: var(--border-color);
  }

  .scroll-progress-indicator {
    stroke: var(--accent-blue);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    transition:
      stroke-dashoffset 80ms linear,
      stroke var(--transition-normal),
      filter var(--transition-fast);
  }

  .scroll-to-top:hover .scroll-progress-indicator {
    filter: drop-shadow(0 0 3px rgba(37, 99, 235, 0.45));
  }

  .scroll-top-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    will-change: transform;
  }

  .scroll-to-top:is(:hover, :focus-visible) .scroll-top-icon {
    animation: arrow-lift 900ms cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes arrow-lift {
    0%,
    100% {
      transform: translateY(0);
    }
    36% {
      transform: translateY(-4px);
    }
    62% {
      transform: translateY(1px);
    }
    80% {
      transform: translateY(-1px);
    }
  }

  @media (max-width: 640px) {
    .scroll-to-top {
      right: 1rem;
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-to-top:is(:hover, :focus-visible) .scroll-top-icon {
      animation: none;
    }

    .scroll-progress-indicator {
      transition: none;
    }
  }
</style>

<script>
  const scrollToTopButton = document.querySelector<HTMLButtonElement>('#scroll-to-top');
  const scrollProgressIndicator = document.querySelector<SVGCircleElement>(
    '#scroll-progress-indicator',
  );

  if (scrollToTopButton && scrollProgressIndicator) {
    let updateQueued = false;

    const updateScrollProgress = () => {
      const documentElement = document.documentElement;
      const scrollableDistance = documentElement.scrollHeight - window.innerHeight;
      const scrollPosition = Math.max(window.scrollY, documentElement.scrollTop);
      const progress =
        scrollableDistance > 0
          ? Math.min(100, Math.max(0, (scrollPosition / scrollableDistance) * 100))
          : 0;
      const revealThreshold = Math.min(320, window.innerHeight * 0.4);
      const shouldShow = scrollableDistance > 200 && scrollPosition > revealThreshold;

      scrollProgressIndicator.style.strokeDashoffset = String(100 - progress);
      scrollToTopButton.classList.toggle('is-visible', shouldShow);
      scrollToTopButton.setAttribute('aria-hidden', String(!shouldShow));
      scrollToTopButton.tabIndex = shouldShow ? 0 : -1;
      updateQueued = false;
    };

    const queueScrollUpdate = () => {
      if (updateQueued) return;
      updateQueued = true;
      window.requestAnimationFrame(updateScrollProgress);
    };

    scrollToTopButton.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mainContent = document.querySelector<HTMLElement>('#main-content');

      mainContent?.focus({ preventScroll: true });
      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    });

    window.addEventListener('scroll', queueScrollUpdate, { passive: true });
    window.addEventListener('resize', queueScrollUpdate);
    updateScrollProgress();
  }
</script>

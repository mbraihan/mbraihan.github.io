---
import { Mail, Github, Linkedin, GraduationCap, MapPin } from 'lucide-astro';
---

<aside class="profile-card">
  <div class="avatar-wrapper">
    <img
      src="/prof_pic.jpg"
      alt="Mohammad Raihanul Bashar"
      class="avatar-img"
      width="800"
      height="800"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="profile-info">
    <p class="profile-affiliation">
      Gina Cody School of Engineering and Computer Science, Concordia University
    </p>
    <div class="profile-location">
      <MapPin size={15} class="location-icon" />
      <span>Montreal, Canada</span>
    </div>
  </div>

  <hr class="divider" />

  <div class="social-links">
    <a
      href="mailto:m.bashar@concordia.ca"
      class="social-btn social-email"
      title="Email"
      aria-label="Email"
    >
      <Mail size={18} />
    </a>
    <a
      href="https://github.com/mbraihan"
      target="_blank"
      rel="noopener noreferrer"
      class="social-btn social-github"
      title="GitHub (opens in a new tab)"
      aria-label="GitHub (opens in a new tab)"
    >
      <Github size={18} />
    </a>
    <a
      href="https://linkedin.com/in/mbraihan"
      target="_blank"
      rel="noopener noreferrer"
      class="social-btn social-linkedin"
      title="LinkedIn (opens in a new tab)"
      aria-label="LinkedIn (opens in a new tab)"
    >
      <Linkedin size={18} />
    </a>
    <a
      href="https://scholar.google.com/citations?user=zDyfhn0AAAAJ&hl=en&oi=ao"
      target="_blank"
      rel="noopener noreferrer"
      class="social-btn social-scholar"
      title="Google Scholar (opens in a new tab)"
      aria-label="Google Scholar (opens in a new tab)"
    >
      <GraduationCap size={18} />
    </a>
    <a
      href="https://orcid.org/0000-0002-5271-457X"
      target="_blank"
      rel="noopener noreferrer"
      class="social-btn social-orcid"
      title="ORCID (opens in a new tab)"
      aria-label="ORCID (opens in a new tab)"
    >
      <svg
        class="orcid-svg"
        viewBox="0 0 256 256"
        width="18"
        height="18"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          fill="#ffffff"
          d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z"
        ></path>
        <path
          fill="#a6ce39"
          d="M86.3 186.2H70.9V79.1h15.4v107.1zM108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4zM86.3 51.5c0 5.1-4.1 9.2-9.2 9.2-5.1 0-9.2-4.1-9.2-9.2s4.1-9.2 9.2-9.2c5.1 0 9.2 4.1 9.2 9.2z"
        ></path>
      </svg>
    </a>
  </div>
</aside>

<style>
  .profile-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: sticky;
    top: 5.5rem;
  }

  .avatar-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
    background-color: var(--bg-pill);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .profile-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .profile-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-blue);
    margin-bottom: 0.4rem;
  }

  .profile-affiliation {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }

  .profile-location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .location-icon {
    color: var(--accent-blue);
    display: block;
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
  }

  .divider {
    width: 100%;
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 1.25rem 0;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  .social-btn {
    width: 2.25rem;
    height: 2.25rem;
    aspect-ratio: 1;
    flex: 0 0 2.25rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      filter var(--transition-fast);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .social-btn :global(svg) {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 1.125rem;
    margin: 0;
    vertical-align: middle;
  }

  .social-btn:hover {
    transform: translateY(-3px) scale(1.06);
    filter: brightness(1.08);
  }

  /* Email - Vivid Gmail Red */
  .social-email {
    background: linear-gradient(135deg, #ea4335, #d93025);
    color: #ffffff;
  }
  .social-email:hover {
    box-shadow: 0 6px 16px rgba(234, 67, 53, 0.45);
  }

  /* GitHub - colorful code-inspired gradient */
  .social-github {
    background: linear-gradient(135deg, #6e40c9 0%, #bf3989 48%, #f0883e 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }
  .social-github :global(svg) {
    filter: drop-shadow(-1px 0 0 rgba(88, 166, 255, 0.8))
      drop-shadow(1px 0 0 rgba(255, 123, 114, 0.75));
  }
  .social-github:hover {
    box-shadow:
      0 6px 16px rgba(191, 57, 137, 0.45),
      0 0 12px rgba(110, 64, 201, 0.35);
  }

  /* LinkedIn - Authentic LinkedIn Blue */
  .social-linkedin {
    background: linear-gradient(135deg, #0a66c2, #004182);
    color: #ffffff;
  }
  .social-linkedin:hover {
    box-shadow: 0 6px 16px rgba(10, 102, 194, 0.45);
  }

  /* Google Scholar - Scholar Blue */
  .social-scholar {
    background: linear-gradient(135deg, #4285f4, #1a73e8);
    color: #ffffff;
  }
  .social-scholar:hover {
    box-shadow: 0 6px 16px rgba(66, 133, 244, 0.45);
  }

  /* ORCID - Official ORCID Green */
  .social-orcid {
    background: linear-gradient(135deg, #a6ce39, #8bb82d);
    color: #ffffff;
  }
  .social-orcid:hover {
    box-shadow: 0 6px 16px rgba(166, 206, 57, 0.45);
  }
</style>

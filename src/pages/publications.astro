---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  BookOpen, Users, Presentation, FileText, Globe, Video, Code2, Database, ExternalLink, Quote, Copy, Check, Search, ChevronDown
} from 'lucide-astro';
import LoopingPreviewVideo from '../components/LoopingPreviewVideo.astro';
import {
  getPublicationPreviewVideo,
  shouldContainPublicationMedia,
} from '../data/publicationMedia';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);

// Calculate counts per publication type
const journalCount = sortedPubs.filter(p => p.data.type === 'Journal').length;
const conferenceCount = sortedPubs.filter(p => p.data.type === 'Conference').length;
const workshopCount = sortedPubs.filter(p => p.data.type === 'Workshop').length;
const bookChapterCount = sortedPubs.filter(p => p.data.type === 'Book Chapter').length;
const posterCount = sortedPubs.filter(p => p.data.type === 'Poster').length;

// Collect unique topic tags
const topicTags = ['All', 'HCI', 'Extended Reality', 'Eye Gaze', '3D Interaction', 'EEG & BCI', 'Robotics'];

const pubTypes = [
  { name: 'Journal', icon: BookOpen, count: journalCount, color: 'emerald' },
  { name: 'Conference', icon: Users, count: conferenceCount, color: 'purple' },
  { name: 'Workshop', icon: Presentation, count: workshopCount, color: 'blue' },
  { name: 'Book Chapter', icon: BookOpen, count: bookChapterCount, color: 'blue' },
  { name: 'Poster', icon: Presentation, count: posterCount, color: 'rose' },
];
---

<BaseLayout
  title="Publications | Mohammad Raihanul Bashar"
  description="Peer-reviewed journal papers, conference papers, book chapters, and posters by Mohammad Raihanul Bashar."
>
  <div class="container pubs-page-container">
    <header class="page-header">
      <h1 class="page-title">Publications</h1>
      <p class="page-subtitle">Peer-reviewed journal papers, conference papers, book chapters, and posters.</p>
    </header>

    <!-- Stat Counter Widgets Row -->
    <div class="stats-grid">
      <div class="stat-card stat-emerald">
        <div class="stat-icon-circle">
          <BookOpen size={20} />
        </div>
        <div class="stat-info">
          <div class="stat-number">{journalCount}</div>
          <div class="stat-label">Journals</div>
        </div>
      </div>

      <div class="stat-card stat-purple">
        <div class="stat-icon-circle">
          <Users size={20} />
        </div>
        <div class="stat-info">
          <div class="stat-number">{conferenceCount}</div>
          <div class="stat-label">Conferences</div>
        </div>
      </div>

      <div class="stat-card stat-blue">
        <div class="stat-icon-circle">
          <BookOpen size={20} />
        </div>
        <div class="stat-info">
          <div class="stat-number">{bookChapterCount}</div>
          <div class="stat-label">Book Chapter</div>
        </div>
      </div>

      <div class="stat-card stat-rose">
        <div class="stat-icon-circle">
          <Presentation size={20} />
        </div>
        <div class="stat-info">
          <div class="stat-number">{posterCount}</div>
          <div class="stat-label">Poster</div>
        </div>
      </div>
    </div>

    <!-- Filter, Search, and Sort Controls Bar -->
    <div class="controls-container">
      <div class="topic-pills-row">
        {topicTags.map((topic, idx) => (
          <button
            type="button"
            class={`topic-pill filter-color-${idx} ${idx === 0 ? 'active' : ''}`}
            data-topic={topic}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {topic}
          </button>
        ))}
      </div>

      <div class="search-sort-row">
        <div class="search-input-wrapper">
          <Search size={16} class="search-icon" />
          <input
            type="text"
            id="pub-search"
            placeholder="Search publications..."
            aria-label="Search publications"
          />
        </div>

        <div class="sort-select-wrapper">
          <select id="pub-sort" aria-label="Sort publications">
            <option value="year-desc">Sort: Year</option>
            <option value="title">Sort: Title</option>
          </select>
          <ChevronDown size={14} class="sort-chevron" />
        </div>

        <button id="clear-filters-btn" class="clear-btn" type="button" disabled>
          Clear filters
        </button>
      </div>
    </div>
    <p id="publication-results-status" class="sr-status" role="status" aria-live="polite"></p>

    <!-- Grouped Publications List -->
    <div class="pubs-sections">
      {pubTypes.map((typeGroup) => {
        const typePubs = sortedPubs.filter((p) => p.data.type === typeGroup.name);
        if (typePubs.length === 0) return null;
        const IconComponent = typeGroup.icon;

        return (
          <section class="pub-type-section" data-type-group={typeGroup.name}>
            <div class="type-header">
              <IconComponent size={20} class={`type-icon icon-${typeGroup.color}`} />
              <h2 class="type-title">{typeGroup.name}</h2>
            </div>

            <div class="type-pubs-list">
              {typePubs.map((pub) => {
                const { data, id } = pub;
                const bibId = `bibtex-pub-${id.replace(/[^a-zA-Z0-9]/g, '-')}`;
                const tagsString = (data.tags || []).join(' ');
                const previewVideo = getPublicationPreviewVideo(id);
                const containMedia = shouldContainPublicationMedia(id);

                return (
                  <article
                    class="pub-card-row"
                    data-title={data.title.toLowerCase()}
                    data-authors={data.authors.join(' ').toLowerCase()}
                    data-venue={data.venue.toLowerCase()}
                    data-year={data.year}
                    data-type={data.type}
                    data-tags={tagsString}
                  >
                    {(previewVideo || data.image) && (
                      <div class:list={[
                        'card-thumb-wrapper',
                        { 'has-looping-video': previewVideo, 'has-contained-media': containMedia },
                      ]}>
                        {previewVideo ? (
                          <LoopingPreviewVideo
                            src={previewVideo}
                            className="card-thumb-img"
                            label={`Looping preview of ${data.title}`}
                          />
                        ) : (
                          <img
                            src={data.image}
                            alt={data.title}
                            class="card-thumb-img"
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </div>
                    )}

                    <div class="card-content-area">
                      <h3 class="card-title">
                        <a href={`/publications/${id}`} class="paper-link">
                          <span>{data.title}</span>
                          <ExternalLink size={15} class="ext-link-icon" />
                        </a>
                      </h3>

                      <p class="card-authors">
                        {data.authors.map((author, aIdx) => (
                          <span>
                            {author === 'Mohammad Raihanul Bashar' ? (
                              <strong class="author-highlight">{author}</strong>
                            ) : (
                              <span>{author}</span>
                            )}
                            {aIdx < data.authors.length - 1 ? ', ' : ''}
                          </span>
                        ))}
                      </p>

                      <!-- 1-2 Sentence TLDR after authors before venue -->
                      <p class="pub-tldr">
                        <strong class="tldr-label">TL;DR:</strong> {data.tldr || data.abstract || 'A novel framework enhancing multimodal interaction in XR.'}
                      </p>

                      <!-- Venue Badge Line -->
                      <div class="venue-row">
                        <span class="venue-badge" title={data.venue}>
                          {data.venueShort || data.venue}
                        </span>
                      </div>

                      <!-- Action Button Chips -->
                      <div class="chips-row">
                        {data.pdf && (
                          <a href={data.pdf} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="PDF (opens in a new tab)">
                            <FileText size={12} />
                            <span>PDF</span>
                          </a>
                        )}
                        {data.poster && (
                          <a href={data.poster} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="Poster (opens in a new tab)">
                            <Presentation size={12} />
                            <span>Poster</span>
                          </a>
                        )}
                        <a href={`/publications/${id}`} class="res-link" title="Publication details">
                          <Globe size={12} />
                          <span>Website</span>
                        </a>
                        {data.video && (
                          <a href={data.video} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="Video (opens in a new tab)">
                            <Video size={12} />
                            <span>Video</span>
                          </a>
                        )}
                        {data.presentation && (
                          <a href={data.presentation} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="Presentation (opens in a new tab)">
                            <Presentation size={12} />
                            <span>Presentation</span>
                          </a>
                        )}
                        {data.code && (
                          <a href={data.code} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="Code (opens in a new tab)">
                            <Code2 size={12} />
                            <span>Code</span>
                          </a>
                        )}
                        {data.data && (
                          <a href={data.data} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="Data (opens in a new tab)">
                            <Database size={12} />
                            <span>Data</span>
                          </a>
                        )}
                        {data.doi && (
                          <a href={data.doi} target="_blank" rel="noopener noreferrer" class="res-link" aria-label="DOI (opens in a new tab)">
                            <ExternalLink size={12} />
                            <span>DOI</span>
                          </a>
                        )}
                        {data.bibtex && (
                          <button
                            class="res-link bibtex-toggle-btn"
                            data-target={bibId}
                            title="Toggle BibTeX"
                          >
                            <Quote size={12} />
                            <span>BibTeX</span>
                          </button>
                        )}
                      </div>

                      {data.bibtex && (
                        <div id={bibId} class="bibtex-box hidden">
                          <button class="copy-btn" data-bib={data.bibtex}>
                            <Copy size={12} class="copy-icon" />
                            <Check size={12} class="check-icon hidden" />
                            <span class="copy-text">Copy</span>
                          </button>
                          <code>{data.bibtex}</code>
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .pubs-page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    max-width: 1100px;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    color: var(--text-main);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
  }

  /* Stat Widgets Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .stat-icon-circle {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-emerald .stat-icon-circle { background-color: #ecfdf5; color: #059669; }
  :global([data-theme='dark']) .stat-emerald .stat-icon-circle { background-color: rgba(5, 150, 105, 0.2); color: #34d399; }

  .stat-purple .stat-icon-circle { background-color: #f3e8ff; color: #7e22ce; }
  :global([data-theme='dark']) .stat-purple .stat-icon-circle { background-color: rgba(126, 34, 206, 0.2); color: #c084fc; }

  .stat-blue .stat-icon-circle { background-color: #eff6ff; color: #2563eb; }
  :global([data-theme='dark']) .stat-blue .stat-icon-circle { background-color: rgba(37, 99, 235, 0.2); color: #60a5fa; }

  .stat-rose .stat-icon-circle { background-color: #ffe4e6; color: #e11d48; }
  :global([data-theme='dark']) .stat-rose .stat-icon-circle { background-color: rgba(225, 29, 72, 0.2); color: #fb7185; }

  .stat-info {
    display: flex;
    flex-direction: flex-start;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--text-main);
    margin-right: 0.5rem;
  }

  .stat-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-subtle);
    align-self: center;
  }

  /* Controls Container */
  .controls-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .topic-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topic-pill {
    padding: 0.4rem 1.1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--border-color);
    background-color: var(--bg-card);
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .topic-pill:hover {
    filter: saturate(1.15);
    transform: translateY(-1px);
  }

  .topic-pill.active {
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--bg-primary), 0 0 0 4px currentColor;
  }

  .filter-color-0 { background-color: #eff6ff; color: #1d4ed8; border-color: #93c5fd; }
  .filter-color-1 { background-color: #ecfdf5; color: #047857; border-color: #6ee7b7; }
  .filter-color-2 { background-color: #f5f3ff; color: #6d28d9; border-color: #c4b5fd; }
  .filter-color-3 { background-color: #fff7ed; color: #c2410c; border-color: #fdba74; }
  .filter-color-4 { background-color: #ecfeff; color: #0e7490; border-color: #67e8f9; }
  .filter-color-5 { background-color: #fff1f2; color: #be123c; border-color: #fda4af; }
  .filter-color-6 { background-color: #f7fee7; color: #4d7c0f; border-color: #bef264; }

  :global([data-theme='dark']) .filter-color-0 { background-color: rgba(37, 99, 235, 0.2); color: #93c5fd; border-color: rgba(147, 197, 253, 0.45); }
  :global([data-theme='dark']) .filter-color-1 { background-color: rgba(5, 150, 105, 0.2); color: #6ee7b7; border-color: rgba(110, 231, 183, 0.45); }
  :global([data-theme='dark']) .filter-color-2 { background-color: rgba(124, 58, 237, 0.2); color: #c4b5fd; border-color: rgba(196, 181, 253, 0.45); }
  :global([data-theme='dark']) .filter-color-3 { background-color: rgba(234, 88, 12, 0.2); color: #fdba74; border-color: rgba(253, 186, 116, 0.45); }
  :global([data-theme='dark']) .filter-color-4 { background-color: rgba(8, 145, 178, 0.2); color: #67e8f9; border-color: rgba(103, 232, 249, 0.45); }
  :global([data-theme='dark']) .filter-color-5 { background-color: rgba(225, 29, 72, 0.2); color: #fda4af; border-color: rgba(253, 164, 175, 0.45); }
  :global([data-theme='dark']) .filter-color-6 { background-color: rgba(101, 163, 13, 0.2); color: #bef264; border-color: rgba(190, 242, 100, 0.45); }

  .search-sort-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
    min-width: 260px;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-subtle);
  }

  #pub-search {
    width: 100%;
    padding: 0.55rem 1rem 0.55rem 2.4rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-card);
    color: var(--text-main);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  #pub-search:focus {
    border-color: var(--accent-blue);
  }

  .sort-select-wrapper {
    position: relative;
  }

  #pub-sort {
    appearance: none;
    padding: 0.55rem 2rem 0.55rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-card);
    color: var(--text-main);
    font-size: 0.88rem;
    font-weight: 500;
    outline: none;
    cursor: pointer;
  }

  .sort-chevron {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-subtle);
    pointer-events: none;
  }

  .clear-btn {
    font-size: 0.85rem;
    color: var(--accent-blue);
    font-weight: 500;
    padding: 0.5rem 0.5rem;
  }

  .clear-btn:hover {
    text-decoration: underline;
  }

  /* Type Sections */
  .pub-type-section {
    margin-bottom: 2.5rem;
  }

  .type-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .type-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .icon-emerald { color: #059669; }
  .icon-purple { color: #7e22ce; }
  .icon-blue { color: #2563eb; }
  .icon-rose { color: #e11d48; }

  /* Publication Cards List - Horizontal Layout */
  .type-pubs-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pub-card-row {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pub-card-row:hover,
  .pub-card-row:focus-within {
    border-color: #60a5fa;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md), 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  :global([data-theme='dark']) .pub-card-row:hover,
  :global([data-theme='dark']) .pub-card-row:focus-within {
    border-color: #60a5fa;
    box-shadow: var(--shadow-md), 0 0 0 3px rgba(96, 165, 250, 0.18);
  }

  .card-thumb-wrapper {
    width: 220px;
    height: 130px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: #0f172a;
  }

  .card-thumb-wrapper.has-looping-video {
    height: auto;
    aspect-ratio: 16 / 9;
    background-color: #000;
  }

  .card-thumb-wrapper.has-contained-media .card-thumb-img {
    object-fit: contain;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content-area {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.35rem;
  }

  .paper-link {
    color: #2563eb;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme='dark']) .paper-link {
    color: #60a5fa;
  }

  .paper-link:hover {
    text-decoration: underline;
  }

  .ext-link-icon {
    flex-shrink: 0;
  }

  .card-authors {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .author-highlight {
    color: var(--text-main);
    font-weight: 600;
  }

  /* 1-2 Sentence TLDR Paragraph */
  .pub-tldr {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.65rem;
    padding: 0.45rem 0.75rem;
    background-color: rgba(13, 148, 136, 0.07);
    border-left: 3px solid #0d9488;
    border-radius: var(--radius-sm);
  }

  .tldr-label {
    color: #0f766e;
    font-weight: 700;
    margin-right: 0.35rem;
  }

  :global([data-theme='dark']) .pub-tldr {
    background-color: rgba(20, 184, 166, 0.12);
    border-left-color: #2dd4bf;
  }

  :global([data-theme='dark']) .tldr-label {
    color: #5eead4;
  }

  /* Venue Row */
  .venue-row {
    margin-bottom: 0.65rem;
  }

  .venue-badge {
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.32rem 0.85rem;
    border-radius: var(--radius-full);
    background-color: #f5f3ff;
    border: 1px solid #c4b5fd;
    color: #6d28d9;
    display: inline-block;
  }

  :global([data-theme='dark']) .venue-badge {
    background-color: rgba(124, 58, 237, 0.18);
    color: #c4b5fd;
    border-color: rgba(196, 181, 253, 0.42);
  }

  /* Chips Row */
  .chips-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.55rem;
    margin-top: 0.65rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--border-subtle);
  }

  .res-link {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.15rem 0;
    border: 0;
    background: none;
    color: var(--text-subtle);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .res-link:hover {
    color: var(--accent-blue);
  }

  .bibtex-box.hidden {
    display: none;
  }

  .check-icon.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pub-card-row {
      flex-direction: column;
    }
    .card-thumb-wrapper {
      width: 100%;
      height: 180px;
    }
    .card-thumb-wrapper.has-looping-video {
      height: auto;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pub-card-row:hover,
    .pub-card-row:focus-within {
      transform: none;
    }
  }
</style>

<script>
  // Search & Topic Filter Logic
  const topicPills = document.querySelectorAll('.topic-pill');
  const searchInput = document.getElementById('pub-search') as HTMLInputElement;
  const sortSelect = document.getElementById('pub-sort') as HTMLSelectElement;
  const clearBtn = document.getElementById('clear-filters-btn');
  const pubCards = document.querySelectorAll('.pub-card-row');
  const typeSections = document.querySelectorAll('.pub-type-section');
  const resultsStatus = document.getElementById('publication-results-status');

  let activeTopic = 'All';

  function filterPublications() {
    const query = searchInput?.value.toLowerCase().trim() || '';

    let visiblePublications = 0;
    pubCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const authors = card.getAttribute('data-authors') || '';
      const venue = card.getAttribute('data-venue') || '';
      const tags = card.getAttribute('data-tags') || '';

      const matchesSearch = !query || title.includes(query) || authors.includes(query) || venue.includes(query) || tags.toLowerCase().includes(query);
      const matchesTopic = activeTopic === 'All' || tags.includes(activeTopic);

      if (matchesSearch && matchesTopic) {
        (card as HTMLElement).style.display = 'flex';
        visiblePublications++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (clearBtn instanceof HTMLButtonElement) {
      clearBtn.disabled = activeTopic === 'All' && query.length === 0;
    }
    if (resultsStatus) {
      resultsStatus.textContent = `${visiblePublications} publication${visiblePublications === 1 ? '' : 's'} shown`;
    }

    // Hide sections that have 0 visible cards
    typeSections.forEach((section) => {
      let visibleCount = 0;
      section.querySelectorAll('.pub-card-row').forEach((c) => {
        if ((c as HTMLElement).style.display !== 'none') visibleCount++;
      });

      (section as HTMLElement).style.display = visibleCount === 0 ? 'none' : 'block';
    });
  }

  topicPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      topicPills.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');
      activeTopic = pill.getAttribute('data-topic') || 'All';
      filterPublications();
    });
  });

  searchInput?.addEventListener('input', filterPublications);

  clearBtn?.addEventListener('click', () => {
    activeTopic = 'All';
    topicPills.forEach((p, idx) => {
      p.classList.toggle('active', idx === 0);
      p.setAttribute('aria-pressed', String(idx === 0));
    });
    if (searchInput) searchInput.value = '';
    filterPublications();
  });

  filterPublications();

  // BibTeX Toggle & Copy Logic
  document.querySelectorAll('.bibtex-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const box = document.getElementById(targetId);
        box?.classList.toggle('hidden');
      }
    });
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-bib');
      if (textToCopy) {
        await navigator.clipboard.writeText(textToCopy);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const copyText = btn.querySelector('.copy-text');

        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (copyText) copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      }
    });
  });
</script>

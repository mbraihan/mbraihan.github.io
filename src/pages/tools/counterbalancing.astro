---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ArrowLeft,
  Check,
  Clipboard,
  Download,
  ExternalLink,
  Info,
  RefreshCw,
  RotateCcw,
  Shuffle,
} from 'lucide-astro';
---

<BaseLayout
  title="Counterbalancing & Randomization Planner | Mohammad Raihanul Bashar"
  description="Generate reproducible balanced Latin square sequences, cyclic Latin squares, and balanced between-subject condition assignments."
>
  <div class="planner-page">
    <a class="back-link" href="/tools">
      <ArrowLeft size={16} aria-hidden="true" />
      Back to Tools
    </a>

    <header class="planner-header">
      <span class="tool-badge">Study Planning Tool</span>
      <h1>Counterbalancing & Randomization Planner</h1>
      <p>
        Create reproducible participant schedules, inspect positional balance,
        and export an assignment plan before data collection begins.
      </p>
    </header>

    <div class="planner-workspace">
      <section class="setup-section" aria-labelledby="design-heading">
        <div class="section-heading">
          <div>
            <span class="step-number">1</span>
            <div>
              <h2 id="design-heading">Choose a design</h2>
              <p>Select the structure that matches how participants experience conditions.</p>
            </div>
          </div>
        </div>

        <fieldset class="design-options">
          <legend class="sr-only">Counterbalancing design</legend>
          <label class="design-option is-selected">
            <input
              type="radio"
              name="design-method"
              value="williams"
              checked
            />
            <span class="design-option-title">Balanced Latin square</span>
            <span class="design-option-copy">
              Within-subject. Balances position and immediate carryover.
            </span>
            <span class="recommended-label">Recommended</span>
          </label>

          <label class="design-option">
            <input type="radio" name="design-method" value="latin" />
            <span class="design-option-title">Cyclic Latin square</span>
            <span class="design-option-copy">
              Within-subject. Balances position with fewer sequence constraints.
            </span>
          </label>

          <label class="design-option">
            <input type="radio" name="design-method" value="between" />
            <span class="design-option-title">Balanced assignment</span>
            <span class="design-option-copy">
              Between-subject. Assigns one condition using randomized blocks.
            </span>
          </label>
        </fieldset>
      </section>

      <section class="setup-section" aria-labelledby="setup-heading">
        <div class="section-heading">
          <div>
            <span class="step-number">2</span>
            <div>
              <h2 id="setup-heading">Define the study</h2>
              <p>Enter one condition per line and choose the planned sample size.</p>
            </div>
          </div>
        </div>

        <div class="setup-grid">
          <div class="field-group conditions-field">
            <label for="condition-list">
              Conditions <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="condition-list"
              rows="6"
              required
              aria-describedby="conditions-help conditions-error"
            >Baseline
Gaze
Controller
Hand tracking</textarea>
            <p id="conditions-help" class="field-help">
              Between 2 and 12 unique conditions.
            </p>
            <p id="conditions-error" class="field-error"></p>
          </div>

          <div class="study-fields">
            <div class="field-group">
              <label for="participant-count">
                Participants <span aria-hidden="true">*</span>
              </label>
              <input
                id="participant-count"
                type="number"
                min="2"
                max="500"
                step="1"
                value="24"
                required
                aria-describedby="participants-error"
              />
              <p id="participants-error" class="field-error"></p>
            </div>

            <div class="field-group">
              <label for="participant-prefix">Participant prefix</label>
              <input
                id="participant-prefix"
                type="text"
                value="P"
                maxlength="12"
                placeholder="P"
              />
            </div>

            <div class="field-group seed-field">
              <label for="random-seed">Randomization seed</label>
              <div class="seed-control">
                <input
                  id="random-seed"
                  type="text"
                  value="HCI-2026"
                  maxlength="80"
                  aria-describedby="seed-help"
                />
                <button
                  id="new-seed"
                  class="icon-button"
                  type="button"
                  title="Generate a new random seed"
                  aria-label="Generate a new random seed"
                >
                  <RefreshCw size={17} aria-hidden="true" />
                </button>
              </div>
              <p id="seed-help" class="field-help">
                Reuse the same seed to reproduce an identical plan.
              </p>
            </div>
          </div>
        </div>

        <div id="validation-alert" class="validation-alert" role="alert" hidden></div>

        <div class="setup-actions">
          <button id="reset-planner" class="secondary-button" type="button">
            <RotateCcw size={17} aria-hidden="true" />
            Reset
          </button>
          <button id="generate-plan" class="primary-button" type="button">
            <Shuffle size={18} aria-hidden="true" />
            Generate plan
          </button>
        </div>
      </section>

      <section class="results-section" aria-labelledby="results-heading">
        <div class="results-header">
          <div>
            <span class="step-number">3</span>
            <div>
              <h2 id="results-heading">Assignment plan</h2>
              <p id="result-description">Balanced within-subject condition orders.</p>
            </div>
          </div>
          <div class="result-actions">
            <button id="copy-plan" class="secondary-button" type="button">
              <Clipboard size={17} aria-hidden="true" />
              <span id="copy-label">Copy</span>
            </button>
            <button id="download-plan" class="secondary-button" type="button">
              <Download size={17} aria-hidden="true" />
              Download CSV
            </button>
          </div>
        </div>

        <div
          id="generation-status"
          class="sr-only"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></div>

        <dl class="summary-strip">
          <div>
            <dt>Participants</dt>
            <dd id="summary-participants">24</dd>
          </div>
          <div>
            <dt>Conditions</dt>
            <dd id="summary-conditions">4</dd>
          </div>
          <div>
            <dt>Base sequences</dt>
            <dd id="summary-sequences">4</dd>
          </div>
          <div>
            <dt>Balance</dt>
            <dd id="summary-balance" class="balance-value">
              <Check size={16} aria-hidden="true" />
              Complete cycles
            </dd>
          </div>
        </dl>

        <div class="results-grid">
          <section class="diagnostics-section" aria-labelledby="diagnostics-heading">
            <div class="subsection-heading">
              <h3 id="diagnostics-heading">Balance diagnostics</h3>
              <span id="diagnostic-status" class="status-badge is-balanced">
                Position balanced
              </span>
            </div>
            <p id="diagnostic-copy" class="diagnostic-copy">
              Each condition appears equally often in every position.
            </p>
            <div
              id="balance-guidance"
              class="balance-guidance"
              role="note"
              hidden
            >
              <div class="guidance-heading">
                <strong>How to complete the cycle</strong>
                <span id="cycle-size"></span>
              </div>
              <p id="participant-guidance"></p>
              <div
                id="participant-suggestion-actions"
                class="recommendation-actions"
              >
                <button
                  id="use-lower-participant-count"
                  type="button"
                  hidden
                ></button>
                <button
                  id="use-upper-participant-count"
                  type="button"
                  hidden
                ></button>
              </div>
              <p id="condition-guidance"></p>
              <p class="guidance-caution">
                Change conditions only when the research question supports it.
                Otherwise, keep the near-balanced plan, recruit as evenly as
                possible, and report the sequence counts.
              </p>
            </div>
            <div class="matrix-scroll">
              <table id="balance-matrix">
                <caption class="sr-only">
                  Number of appearances for each condition at each sequence position
                </caption>
                <thead id="matrix-head"></thead>
                <tbody id="matrix-body"></tbody>
              </table>
            </div>
          </section>

          <aside class="method-panel" aria-labelledby="method-heading">
            <Info size={18} aria-hidden="true" />
            <div>
              <h3 id="method-heading">Method note</h3>
              <p id="method-note">
                For an even number of conditions, the Williams design requires one
                sequence per condition. Odd condition counts require twice as many
                sequences to balance immediate carryover.
              </p>
              <div class="method-links">
                <a
                  href="https://doi.org/10.1071/CH9490149"
                  target="_blank"
                  rel="noreferrer"
                >
                  Williams (1949)
                  <ExternalLink size={13} aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a
                  href="https://www.itl.nist.gov/div898/handbook/pri/section3/pri3321.htm"
                  target="_blank"
                  rel="noreferrer"
                >
                  NIST design guidance
                  <ExternalLink size={13} aria-hidden="true" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </div>
            </div>
          </aside>
        </div>

        <section class="schedule-section" aria-labelledby="schedule-heading">
          <div class="subsection-heading">
            <div>
              <h3 id="schedule-heading">Participant schedule</h3>
              <p id="schedule-count">24 assignments</p>
            </div>
          </div>
          <div class="schedule-scroll">
            <table id="schedule-table">
              <caption class="sr-only">Generated participant assignment schedule</caption>
              <thead>
                <tr>
                  <th scope="col">Participant</th>
                  <th scope="col">Sequence</th>
                  <th scope="col">Condition order or assignment</th>
                </tr>
              </thead>
              <tbody id="schedule-body"></tbody>
            </table>
          </div>
        </section>

        <p class="privacy-note">
          All planning and randomization happen in this browser. Nothing is uploaded;
          CSV export creates a file on this device.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .planner-page {
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .back-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--accent-blue);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .planner-header {
    max-width: 780px;
    margin-bottom: 1.75rem;
  }

  .tool-badge {
    display: block;
    margin-bottom: 0.3rem;
    color: #0f766e;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global([data-theme='dark']) .tool-badge {
    color: #5eead4;
  }

  .planner-header h1 {
    margin-bottom: 0.5rem;
    font-size: 2.15rem;
    letter-spacing: 0;
  }

  .planner-header p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .planner-workspace {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .setup-section,
  .results-section {
    padding: 1.5rem;
  }

  .setup-section + .setup-section,
  .results-section {
    border-top: 1px solid var(--border-color);
  }

  .section-heading,
  .section-heading > div,
  .results-header > div:first-child {
    display: flex;
    align-items: center;
  }

  .section-heading {
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-heading > div,
  .results-header > div:first-child {
    gap: 0.7rem;
  }

  .step-number {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-blue);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .section-heading h2,
  .results-header h2 {
    font-size: 1.05rem;
  }

  .section-heading p,
  .results-header p {
    margin-top: 0.08rem;
    color: var(--text-subtle);
    font-size: 0.78rem;
  }

  .design-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    border: 0;
  }

  .design-option {
    min-width: 0;
    min-height: 112px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-pill);
    cursor: pointer;
  }

  .design-option:hover {
    border-color: var(--accent-blue-border);
  }

  .design-option:focus-within {
    outline: 3px solid var(--accent-blue);
    outline-offset: 2px;
  }

  .design-option.is-selected {
    border-color: var(--accent-blue);
    background: var(--accent-blue-light);
    box-shadow: inset 0 0 0 1px var(--accent-blue);
  }

  .design-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .design-option-title {
    padding-right: 5.5rem;
    color: var(--text-main);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .design-option-copy {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .recommended-label {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.18rem 0.36rem;
    border-radius: 3px;
    background: var(--accent-blue);
    color: #fff;
    font-size: 0.54rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .setup-grid {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(320px, 1.2fr);
    gap: 1.25rem;
  }

  .study-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 1rem;
  }

  .seed-field {
    grid-column: 1 / -1;
  }

  .field-group {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .field-group label {
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .field-group label span {
    color: #dc2626;
  }

  .field-group input,
  .field-group textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    outline: 0;
    background: var(--bg-pill);
    color: var(--text-main);
    font: inherit;
    font-size: 0.86rem;
  }

  .field-group textarea {
    min-height: 160px;
    resize: vertical;
    line-height: 1.5;
  }

  .field-group input:focus-visible,
  .field-group textarea:focus-visible {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px var(--accent-blue-light);
  }

  .field-group input[aria-invalid='true'],
  .field-group textarea[aria-invalid='true'] {
    border-color: #dc2626;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
  }

  .field-help,
  .field-error {
    min-height: 1em;
    color: var(--text-subtle);
    font-size: 0.67rem;
    line-height: 1.35;
  }

  .field-error {
    color: #b91c1c;
  }

  :global([data-theme='dark']) .field-error {
    color: #fca5a5;
  }

  .seed-control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    gap: 0.5rem;
  }

  .icon-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--accent-blue);
  }

  .icon-button:hover {
    border-color: var(--accent-blue);
    background: var(--accent-blue-light);
  }

  .validation-alert {
    margin-top: 1rem;
    padding: 0.7rem 0.85rem;
    border-left: 3px solid #dc2626;
    background: rgba(220, 38, 38, 0.07);
    color: #b91c1c;
    font-size: 0.78rem;
  }

  :global([data-theme='dark']) .validation-alert {
    color: #fca5a5;
  }

  .setup-actions,
  .result-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .setup-actions {
    margin-top: 1rem;
  }

  .primary-button,
  .secondary-button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.62rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .primary-button {
    border: 1px solid var(--accent-blue);
    background: var(--accent-blue);
    color: #fff;
  }

  .primary-button:hover {
    background: #1d4ed8;
  }

  .secondary-button {
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-main);
  }

  .secondary-button:hover {
    border-color: var(--accent-blue);
    background: var(--accent-blue-light);
    color: var(--accent-blue);
  }

  .primary-button:focus-visible,
  .secondary-button:focus-visible,
  .icon-button:focus-visible,
  .method-links a:focus-visible {
    outline: 3px solid var(--accent-blue);
    outline-offset: 2px;
  }

  .results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .summary-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .summary-strip > div {
    min-width: 0;
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--border-color);
  }

  .summary-strip > div:last-child {
    border-right: 0;
  }

  .summary-strip dt {
    color: var(--text-subtle);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .summary-strip dd {
    margin-top: 0.12rem;
    color: var(--text-main);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .summary-strip .balance-value {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #15803d;
    font-size: 0.78rem;
  }

  .summary-strip .balance-value.is-partial {
    color: #b45309;
  }

  :global([data-theme='dark']) .summary-strip .balance-value {
    color: #86efac;
  }

  :global([data-theme='dark']) .summary-strip .balance-value.is-partial {
    color: #fcd34d;
  }

  .results-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.75fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .diagnostics-section {
    min-width: 0;
  }

  .subsection-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }

  .subsection-heading h3,
  .method-panel h3 {
    color: var(--text-main);
    font-size: 0.9rem;
  }

  .subsection-heading p {
    color: var(--text-subtle);
    font-size: 0.7rem;
  }

  .status-badge {
    padding: 0.22rem 0.4rem;
    border-radius: 3px;
    background: var(--bg-pill);
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .status-badge.is-balanced {
    background: rgba(22, 163, 74, 0.1);
    color: #15803d;
  }

  .status-badge.is-near {
    background: rgba(217, 119, 6, 0.1);
    color: #b45309;
  }

  :global([data-theme='dark']) .status-badge.is-balanced {
    color: #86efac;
  }

  :global([data-theme='dark']) .status-badge.is-near {
    color: #fcd34d;
  }

  .diagnostic-copy {
    margin-bottom: 0.7rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .balance-guidance {
    margin-bottom: 0.85rem;
    padding: 0.8rem 0.9rem;
    border-left: 3px solid #d97706;
    border-radius: 4px;
    background: rgba(217, 119, 6, 0.08);
    color: var(--text-muted);
  }

  .guidance-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.38rem;
  }

  .guidance-heading strong {
    color: var(--text-main);
    font-size: 0.76rem;
  }

  .guidance-heading span {
    color: #b45309;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global([data-theme='dark']) .guidance-heading span {
    color: #fcd34d;
  }

  .balance-guidance > p {
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .balance-guidance > p + p,
  .guidance-caution {
    margin-top: 0.45rem;
  }

  .recommendation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.55rem 0;
  }

  .recommendation-actions button {
    min-height: 44px;
    padding: 0.48rem 0.68rem;
    border: 1px solid var(--accent-blue-border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    color: var(--accent-blue);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .recommendation-actions button:hover {
    border-color: var(--accent-blue);
    background: var(--accent-blue-light);
  }

  .recommendation-actions button:focus-visible {
    outline: 3px solid var(--accent-blue);
    outline-offset: 2px;
  }

  .guidance-caution {
    padding-top: 0.45rem;
    border-top: 1px solid rgba(217, 119, 6, 0.22);
    color: var(--text-subtle);
  }

  .matrix-scroll,
  .schedule-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  :global(.planner-page table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.74rem;
  }

  :global(.planner-page th),
  :global(.planner-page td) {
    padding: 0.55rem 0.65rem;
    border-right: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    color: var(--text-muted);
    text-align: left;
  }

  :global(.planner-page th) {
    background: var(--bg-pill);
    color: var(--text-main);
    font-weight: 700;
  }

  :global(.planner-page th:last-child),
  :global(.planner-page td:last-child) {

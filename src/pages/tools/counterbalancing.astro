    }

    .design-option {
      min-height: 0;
    }

    .method-panel {
      padding-top: 0.85rem;
      padding-left: 0;
      border-top: 3px solid var(--accent-blue);
      border-left: 0;
    }
  }

  @media (max-width: 640px) {
    .planner-page {
      padding: 1.5rem 1rem 4rem;
    }

    .planner-header h1 {
      font-size: 1.65rem;
    }

    .setup-section,
    .results-section {
      padding: 1rem;
    }

    .setup-grid,
    .study-fields {
      grid-template-columns: 1fr;
    }

    .seed-field {
      grid-column: auto;
    }

    .results-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .result-actions,
    .result-actions .secondary-button {
      width: 100%;
    }

    .summary-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .summary-strip > div:nth-child(2) {
      border-right: 0;
    }

    .summary-strip > div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border-color);
    }

    .setup-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    :global(.schedule-scroll th:first-child),
    :global(.schedule-scroll td:first-child) {
      width: 94px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  type DesignMethod = 'williams' | 'latin' | 'between';

  interface Assignment {
    participant: string;
    sequenceNumber: number;
    conditions: string[];
  }

  interface Plan {
    method: DesignMethod;
    conditions: string[];
    assignments: Assignment[];
    baseSequences: number[][];
    positionCounts: number[][];
    completeCycles: boolean;
    seed: string;
  }

  const conditionInput =
    document.querySelector<HTMLTextAreaElement>('#condition-list');
  const participantInput =
    document.querySelector<HTMLInputElement>('#participant-count');
  const prefixInput =
    document.querySelector<HTMLInputElement>('#participant-prefix');
  const seedInput = document.querySelector<HTMLInputElement>('#random-seed');
  const generateButton =
    document.querySelector<HTMLButtonElement>('#generate-plan');
  const resetButton =
    document.querySelector<HTMLButtonElement>('#reset-planner');
  const newSeedButton = document.querySelector<HTMLButtonElement>('#new-seed');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-plan');
  const downloadButton =
    document.querySelector<HTMLButtonElement>('#download-plan');
  const validationAlert =
    document.querySelector<HTMLElement>('#validation-alert');
  const conditionsError =
    document.querySelector<HTMLElement>('#conditions-error');
  const participantsError =
    document.querySelector<HTMLElement>('#participants-error');

  let currentPlan: Plan | null = null;

  const hashSeed = (value: string) => {
    let hash = 2166136261;
    for (let index = 0; index < value.length; index += 1) {
      hash ^= value.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return hash >>> 0;
  };

  const createRandom = (seed: string) => {
    let state = hashSeed(seed) || 0x6d2b79f5;
    return () => {
      state += 0x6d2b79f5;
      let value = state;
      value = Math.imul(value ^ (value >>> 15), value | 1);
      value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
      return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
    };
  };

  function shuffle<T>(items: T[], random: () => number) {
    const result = [...items];
    for (let index = result.length - 1; index > 0; index -= 1) {
      const target = Math.floor(random() * (index + 1));
      [result[index], result[target]] = [result[target], result[index]];
    }
    return result;
  }

  const createWilliamsSequences = (count: number) => {
    const firstRow: number[] = [];
    let low = 0;
    let high = count - 1;

    while (firstRow.length < count) {
      firstRow.push(low);
      low += 1;
      if (firstRow.length < count) {
        firstRow.push(low);
        low += 1;
      }
      if (firstRow.length < count) {
        firstRow.push(high);
        high -= 1;
      }
    }

    const rows = Array.from({ length: count }, (_, rowIndex) =>
      firstRow.map((condition) => (condition + rowIndex) % count),
    );

    return count % 2 === 0
      ? rows
      : [...rows, ...rows.map((row) => [...row].reverse())];
  };

  const createLatinSequences = (count: number) =>
    Array.from({ length: count }, (_, rowIndex) =>
      Array.from(
        { length: count },
        (_, position) => (rowIndex + position) % count,
      ),
    );

  const buildParticipantIds = (count: number, prefix: string) => {
    const padding = Math.max(2, String(count).length);
    return Array.from(
      { length: count },
      (_, index) => `${prefix}${String(index + 1).padStart(padding, '0')}`,
    );
  };

  const getSequenceSubsetScore = (
    baseSequences: number[][],
    sequenceIndices: number[],
  ) => {
    const conditionCount =
      Math.max(...baseSequences.flatMap((sequence) => sequence)) + 1;
    const positionCount = baseSequences[0]?.length || 0;
    const positionCounts = Array.from({ length: conditionCount }, () =>
      Array(positionCount).fill(0),
    );
    const carryoverCounts = Array.from({ length: conditionCount }, () =>
      Array(conditionCount).fill(0),
    );

    sequenceIndices.forEach((sequenceIndex) => {
      const sequence = baseSequences[sequenceIndex];
      sequence.forEach((condition, position) => {
        positionCounts[condition][position] += 1;
        if (position > 0) {
          carryoverCounts[sequence[position - 1]][condition] += 1;
        }
      });
    });

    const positionRanges = Array.from({ length: positionCount }, (_, position) => {
      const values = positionCounts.map((counts) => counts[position]);
      return Math.max(...values) - Math.min(...values);
    });
    const carryoverValues = carryoverCounts.flatMap((row, previous) =>
      row.filter((_, current) => current !== previous),
    );
    const carryoverRange =
      carryoverValues.length > 0
        ? Math.max(...carryoverValues) - Math.min(...carryoverValues)
        : 0;
    const positionSquareSum = positionCounts
      .flat()
      .reduce((sum, value) => sum + value * value, 0);

    return (
      Math.max(...positionRanges, 0) * 1_000_000_000 +
      positionRanges.reduce((sum, value) => sum + value, 0) * 10_000_000 +
      carryoverRange * 100_000 +
      positionSquareSum
    );
  };

  const selectBalancedPartialSequences = (
    baseSequences: number[][],
    requiredCount: number,
    random: () => number,
  ) => {
    const candidateOrder = shuffle(
      baseSequences.map((_, index) => index),
      random,
    );
    let selected: number[] = [];

    while (selected.length < requiredCount) {
      const available = candidateOrder.filter(
        (candidate) => !selected.includes(candidate),
      );
      let bestCandidate = available[0];
      let bestScore = Number.POSITIVE_INFINITY;

      available.forEach((candidate) => {
        const score = getSequenceSubsetScore(baseSequences, [
          ...selected,
          candidate,
        ]);
        if (score < bestScore) {
          bestCandidate = candidate;
          bestScore = score;
        }
      });
      selected.push(bestCandidate);
    }

    let improved = true;
    while (improved) {
      improved = false;
      const unselected = candidateOrder.filter(
        (candidate) => !selected.includes(candidate),
      );
      const currentScore = getSequenceSubsetScore(baseSequences, selected);

      for (
        let selectedIndex = 0;
        selectedIndex < selected.length;
        selectedIndex += 1
      ) {
        for (const replacement of unselected) {
          const candidateSet = [...selected];
          candidateSet[selectedIndex] = replacement;
          if (
            getSequenceSubsetScore(baseSequences, candidateSet) < currentScore
          ) {
            selected = candidateSet;
            improved = true;
            break;
          }
        }
        if (improved) break;
      }
    }

    return shuffle(selected, random);
  };

  const assignSequences = (
    participantIds: string[],
    baseSequences: number[][],
    random: () => number,
  ) => {
    const assignments: Array<{ participant: string; sequence: number[]; sequenceNumber: number }> = [];
    const fullCycleCount = Math.floor(
      participantIds.length / baseSequences.length,
    );
    const partialCycleSize = participantIds.length % baseSequences.length;
    const assignedSequenceIndices: number[] = [];

    for (let cycle = 0; cycle < fullCycleCount; cycle += 1) {
      assignedSequenceIndices.push(
        ...shuffle(
          baseSequences.map((_, index) => index),
          random,
        ),
      );
    }
    if (partialCycleSize > 0) {
      assignedSequenceIndices.push(
        ...selectBalancedPartialSequences(
          baseSequences,
          partialCycleSize,
          random,
        ),
      );
    }

    assignedSequenceIndices.forEach((sequenceIndex, participantIndex) => {
      assignments.push({
        participant: participantIds[participantIndex],
        sequence: baseSequences[sequenceIndex],
        sequenceNumber: sequenceIndex + 1,
      });
    });

    return assignments;
  };

  const calculatePositionCounts = (
    assignments: Assignment[],
    conditionCount: number,
    betweenSubjects: boolean,
  ) => {
    const positionCount = betweenSubjects ? 1 : conditionCount;
    const counts = Array.from({ length: conditionCount }, () =>
      Array(positionCount).fill(0),
    );

    assignments.forEach((assignment) => {
      assignment.conditions.forEach((condition, position) => {
        const conditionIndex = Number(condition);
        counts[conditionIndex][position] += 1;
      });
    });
    return counts;
  };

  const clearValidation = () => {
    [conditionInput, participantInput].forEach((field) => {
      field?.removeAttribute('aria-invalid');
    });
    if (conditionsError) conditionsError.textContent = '';
    if (participantsError) participantsError.textContent = '';
    if (validationAlert) {
      validationAlert.textContent = '';
      validationAlert.hidden = true;
    }
  };

  const getConditions = () =>
    (conditionInput?.value || '')
      .split('\n')
      .map((condition) => condition.trim())
      .filter(Boolean);

  const validateInputs = () => {
    clearValidation();
    const conditions = getConditions();
    const uniqueConditions = new Set(
      conditions.map((condition) => condition.toLowerCase()),
    );
    const participantCount = Number(participantInput?.value || 0);
    let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
    const messages: string[] = [];

    if (conditions.length < 2 || conditions.length > 12) {
      conditionInput?.setAttribute('aria-invalid', 'true');
      if (conditionsError) {
        conditionsError.textContent = 'Enter between 2 and 12 conditions.';
      }
      firstInvalid = conditionInput;
      messages.push('Enter between 2 and 12 conditions');
    } else if (uniqueConditions.size !== conditions.length) {
      conditionInput?.setAttribute('aria-invalid', 'true');
      if (conditionsError) {
        conditionsError.textContent = 'Each condition name must be unique.';
      }
      firstInvalid = conditionInput;
      messages.push('Use a unique name for every condition');
    }

    if (
      !Number.isInteger(participantCount) ||
      participantCount < 2 ||
      participantCount > 500
    ) {
      participantInput?.setAttribute('aria-invalid', 'true');
      if (participantsError) {
        participantsError.textContent =
          'Enter a whole number from 2 through 500.';
      }
      if (!firstInvalid) firstInvalid = participantInput;
      messages.push('Enter 2 to 500 participants');
    }

    if (messages.length > 0) {
      if (validationAlert) {
        validationAlert.textContent = `${messages.join('. ')}.`;
        validationAlert.hidden = false;
      }
      firstInvalid?.focus();
      return null;
    }

    return { conditions, participantCount };
  };

  const getSelectedMethod = () =>
    (
      document.querySelector<HTMLInputElement>(
        'input[name="design-method"]:checked',
      )?.value || 'williams'
    ) as DesignMethod;

  const createPlan = () => {
    const values = validateInputs();
    if (!values) return null;

    const method = getSelectedMethod();
    const seed = seedInput?.value.trim() || 'HCI-study';
    const random = createRandom(seed);
    const conditionIndices = values.conditions.map((_, index) => index);
    const conditionOrder = shuffle(conditionIndices, random);
    const participantIds = buildParticipantIds(
      values.participantCount,
      prefixInput?.value.trim() || 'P',
    );

    let baseSequences: number[][];
    if (method === 'between') {
      baseSequences = conditionOrder.map((condition) => [condition]);
    } else {
      const structuralSequences =
        method === 'williams'
          ? createWilliamsSequences(values.conditions.length)
          : createLatinSequences(values.conditions.length);
      baseSequences = structuralSequences.map((sequence) =>
        sequence.map((condition) => conditionOrder[condition]),
      );
    }

    const rawAssignments = assignSequences(participantIds, baseSequences, random);
    const assignments: Assignment[] = rawAssignments.map((assignment) => ({
      participant: assignment.participant,
      sequenceNumber: assignment.sequenceNumber,
      conditions: assignment.sequence.map(String),
    }));
    const completeCycles =
      values.participantCount % baseSequences.length === 0;

    return {
      method,
      conditions: values.conditions,
      assignments,
      baseSequences,
      positionCounts: calculatePositionCounts(
        assignments,
        values.conditions.length,
        method === 'between',
      ),
      completeCycles,
      seed,
    };
  };

  const renderSequence = (conditionIndices: string[], conditions: string[]) =>
    conditionIndices
      .map(
        (condition, index) =>
          `<span>${escapeHtml(conditions[Number(condition)])}</span>${
            index < conditionIndices.length - 1
              ? '<i class="sequence-arrow" aria-hidden="true">→</i>'
              : ''
          }`,
      )
      .join('');

  const escapeHtml = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const getMaxPositionDifference = (counts: number[][]) => {
    const positionCount = counts[0]?.length || 0;
    let maximumDifference = 0;
    for (let position = 0; position < positionCount; position += 1) {
      const values = counts.map((conditionCounts) => conditionCounts[position]);
      maximumDifference = Math.max(
        maximumDifference,
        Math.max(...values) - Math.min(...values),
      );
    }
    return maximumDifference;
  };

  const getRequiredSequenceCount = (
    method: DesignMethod,
    conditionCount: number,
  ) =>
    method === 'williams' && conditionCount % 2 !== 0
      ? conditionCount * 2
      : conditionCount;

  const getBalanceRecommendations = (plan: Plan) => {
    const participantCount = plan.assignments.length;
    const conditionCount = plan.conditions.length;
    const sequenceCount = getRequiredSequenceCount(plan.method, conditionCount);
    const lowerParticipantCount =
      Math.floor(participantCount / sequenceCount) * sequenceCount;
    const upperParticipantCount =
      Math.ceil(participantCount / sequenceCount) * sequenceCount;
    const validConditionCounts = Array.from(
      { length: 11 },
      (_, index) => index + 2,
    ).filter(
      (candidate) =>
        candidate !== conditionCount &&
        participantCount %
          getRequiredSequenceCount(plan.method, candidate) ===
          0,
    );

    return {
      sequenceCount,
      lowerParticipantCount:
        lowerParticipantCount >= 2 ? lowerParticipantCount : null,
      upperParticipantCount:
        upperParticipantCount <= 500 ? upperParticipantCount : null,
      lowerConditionCount:
        [...validConditionCounts]
          .filter((candidate) => candidate < conditionCount)
          .sort((a, b) => b - a)[0] || null,
      upperConditionCount:
        validConditionCounts
          .filter((candidate) => candidate > conditionCount)
          .sort((a, b) => a - b)[0] || null,
    };
  };

  const renderPlan = (plan: Plan) => {
    currentPlan = plan;
    const summaryParticipants =
      document.querySelector<HTMLElement>('#summary-participants');
    const summaryConditions =
      document.querySelector<HTMLElement>('#summary-conditions');
    const summarySequences =
      document.querySelector<HTMLElement>('#summary-sequences');
    const summaryBalance =
      document.querySelector<HTMLElement>('#summary-balance');
    const resultDescription =
      document.querySelector<HTMLElement>('#result-description');
    const diagnosticStatus =
      document.querySelector<HTMLElement>('#diagnostic-status');
    const diagnosticCopy =
      document.querySelector<HTMLElement>('#diagnostic-copy');
    const balanceGuidance =
      document.querySelector<HTMLElement>('#balance-guidance');
    const cycleSize = document.querySelector<HTMLElement>('#cycle-size');
    const participantGuidance =
      document.querySelector<HTMLElement>('#participant-guidance');
    const conditionGuidance =
      document.querySelector<HTMLElement>('#condition-guidance');
    const lowerParticipantButton =
      document.querySelector<HTMLButtonElement>(
        '#use-lower-participant-count',
      );
    const upperParticipantButton =
      document.querySelector<HTMLButtonElement>(
        '#use-upper-participant-count',
      );
    const methodNote = document.querySelector<HTMLElement>('#method-note');
    const matrixHead = document.querySelector<HTMLElement>('#matrix-head');
    const matrixBody = document.querySelector<HTMLElement>('#matrix-body');
    const scheduleBody = document.querySelector<HTMLElement>('#schedule-body');
    const scheduleCount = document.querySelector<HTMLElement>('#schedule-count');
    const generationStatus =
      document.querySelector<HTMLElement>('#generation-status');
    const maximumPositionDifference = getMaxPositionDifference(
      plan.positionCounts,
    );
    const balanced = maximumPositionDifference <= 1;

    if (summaryParticipants) {
      summaryParticipants.textContent = String(plan.assignments.length);
    }
    if (summaryConditions) {
      summaryConditions.textContent = String(plan.conditions.length);
    }
    if (summarySequences) {
      summarySequences.textContent = String(plan.baseSequences.length);
    }
    if (summaryBalance) {
      summaryBalance.className = `balance-value ${
        plan.completeCycles ? 'is-complete' : 'is-partial'
      }`;
      summaryBalance.innerHTML = `<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>${plan.completeCycles ? 'Complete cycles' : 'Partial final cycle'}`;
    }
    if (resultDescription) {
      resultDescription.textContent =
        plan.method === 'between'
          ? 'Balanced between-subject condition assignments.'
          : 'Balanced within-subject condition orders.';
    }

    if (diagnosticStatus) {
      diagnosticStatus.textContent = balanced
        ? plan.completeCycles
          ? 'Position balanced'
          : 'Near balanced'
        : 'Review balance';
      diagnosticStatus.className = `status-badge ${
        balanced && plan.completeCycles ? 'is-balanced' : 'is-near'
      }`;
    }
    if (diagnosticCopy) {
      diagnosticCopy.textContent = plan.completeCycles
        ? plan.method === 'between'
          ? 'Each condition has the same number of assigned participants.'
          : 'Each condition appears equally often in every sequence position.'
        : maximumPositionDifference <= 1
          ? 'The final sequence cycle is incomplete, but position counts differ by at most one.'
          : `The final sequence cycle is incomplete; some position counts differ by up to ${maximumPositionDifference}.`;
    }

    const recommendations = getBalanceRecommendations(plan);
    if (balanceGuidance) {
      balanceGuidance.hidden = plan.completeCycles;
    }
    if (cycleSize) {
      cycleSize.textContent = `${recommendations.sequenceCount}-participant cycle`;
    }
    if (participantGuidance) {
      const participantOptions = [
        recommendations.lowerParticipantCount !== null
          ? `reduce to ${recommendations.lowerParticipantCount}`
          : null,
        recommendations.upperParticipantCount !== null
          ? `increase to ${recommendations.upperParticipantCount}`
          : null,
      ].filter(Boolean);
      participantGuidance.textContent =
        participantOptions.length > 0
          ? `For complete cycles, ${participantOptions.join(' or ')} participants.`
          : 'No complete participant cycle falls within the supported range.';
    }

    const configureParticipantButton = (
      button: HTMLButtonElement | null,
      count: number | null,
    ) => {
      if (!button) return;
      button.hidden = count === null || plan.completeCycles;
      if (count === null) {
        delete button.dataset.participantCount;
        return;
      }
      const difference = Math.abs(plan.assignments.length - count);
      button.dataset.participantCount = String(count);
      button.textContent = `Use ${count} participants (${difference} ${
        count < plan.assignments.length ? 'fewer' : 'more'
      })`;
    };
    configureParticipantButton(
      lowerParticipantButton,
      recommendations.lowerParticipantCount,
    );
    configureParticipantButton(
      upperParticipantButton,
      recommendations.upperParticipantCount,
    );

    if (conditionGuidance) {
      const conditionOptions = [
        recommendations.lowerConditionCount !== null
          ? `${recommendations.lowerConditionCount} conditions (remove ${
              plan.conditions.length - recommendations.lowerConditionCount
            })`
          : null,
        recommendations.upperConditionCount !== null
          ? `${recommendations.upperConditionCount} conditions (add ${
              recommendations.upperConditionCount - plan.conditions.length
            })`
          : null,
      ].filter(Boolean);
      conditionGuidance.textContent =
        conditionOptions.length > 0
          ? `With ${plan.assignments.length} participants, ${conditionOptions.join(
              ' or ',
            )} would also complete the selected design.`
          : `No alternative condition count from 2 to 12 completes this design with ${plan.assignments.length} participants.`;
    }

    if (methodNote) {
      if (plan.method === 'williams') {
        methodNote.textContent =
          plan.conditions.length % 2 === 0
            ? 'This Williams design uses one sequence per condition to balance position and immediate carryover.'
            : 'Odd condition counts use a doubled Williams sequence set to balance immediate carryover.';
      } else if (plan.method === 'latin') {
        methodNote.textContent =
          'A cyclic Latin square balances position, but does not guarantee balance for immediate carryover between conditions.';
      } else {
        methodNote.textContent =
          'Randomized blocks contain each condition once before a new block begins, keeping assignment totals as equal as the sample size allows.';
      }
    }

    if (matrixHead) {
      const positionLabels =
        plan.method === 'between'
          ? ['Assigned']
          : plan.conditions.map((_, index) => `Position ${index + 1}`);
      matrixHead.innerHTML = `<tr><th scope="col">Condition</th>${positionLabels
        .map((label) => `<th scope="col">${label}</th>`)
        .join('')}</tr>`;
    }
    if (matrixBody) {
      matrixBody.innerHTML = plan.conditions
        .map(
          (condition, conditionIndex) =>
            `<tr><th scope="row">${escapeHtml(condition)}</th>${plan.positionCounts[
              conditionIndex
            ]
              .map((count) => `<td>${count}</td>`)
              .join('')}</tr>`,
        )
        .join('');
    }
    if (scheduleBody) {
      scheduleBody.innerHTML = plan.assignments
        .map(
          (assignment) =>
            `<tr><th scope="row">${escapeHtml(assignment.participant)}</th><td>${
              plan.method === 'between'
                ? 'Block assignment'
                : `Sequence ${assignment.sequenceNumber}`
            }</td><td><div class="condition-sequence">${renderSequence(
              assignment.conditions,
              plan.conditions,
            )}</div></td></tr>`,
        )
        .join('');
    }
    if (scheduleCount) {
      scheduleCount.textContent = `${plan.assignments.length} assignments`;
    }
    if (generationStatus) {
      generationStatus.textContent = `Generated ${plan.assignments.length} participant assignments across ${plan.conditions.length} conditions using the ${plan.method === 'williams' ? 'balanced Latin square' : plan.method === 'latin' ? 'cyclic Latin square' : 'balanced assignment'} method.${plan.completeCycles ? '' : ` This is a partial cycle; the nearest supported complete counts are ${recommendations.lowerParticipantCount ?? 'unavailable'} and ${recommendations.upperParticipantCount ?? 'unavailable'} participants.`}`;
    }
  };

  const planToRows = (plan: Plan) => [
    ['Participant', 'Sequence', 'Condition order or assignment', 'Method', 'Seed'],
    ...plan.assignments.map((assignment) => [
      assignment.participant,
      plan.method === 'between'
        ? 'Block assignment'
        : `Sequence ${assignment.sequenceNumber}`,
      assignment.conditions
        .map((condition) => plan.conditions[Number(condition)])
        .join(' > '),
      plan.method,
      plan.seed,
    ]),
  ];

  const safeSpreadsheetValue = (value: string) =>
    /^[=+\-@]/.test(value) ? `'${value}` : value;

  const escapeCsv = (value: string) =>
    `"${safeSpreadsheetValue(value).replaceAll('"', '""')}"`;

  const downloadCsv = () => {
    if (!currentPlan) return;
    const csv = planToRows(currentPlan)
      .map((row) => row.map(escapeCsv).join(','))
      .join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `counterbalancing-plan-${currentPlan.seed
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')}.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  };

  const copyPlan = async () => {
    if (!currentPlan) return;
    const text = planToRows(currentPlan)
      .map((row) => row.map(safeSpreadsheetValue).join('\t'))
      .join('\n');
    try {
      await navigator.clipboard.writeText(text);
      const label = document.querySelector<HTMLElement>('#copy-label');
      if (label) {
        label.textContent = 'Copied';
        window.setTimeout(() => {
          label.textContent = 'Copy';
        }, 1800);
      }
    } catch {
      if (validationAlert) {
        validationAlert.textContent =
          'The browser could not access the clipboard. Download the CSV instead.';
        validationAlert.hidden = false;
      }
    }
  };

  const generateNewSeed = () => {
    if (!seedInput) return;
    const values = new Uint32Array(2);
    crypto.getRandomValues(values);
    seedInput.value = `HCI-${values[0].toString(36)}-${values[1].toString(36)}`;
    const plan = createPlan();
    if (plan) renderPlan(plan);
  };

  const resetPlanner = () => {
    if (conditionInput) {
      conditionInput.value = 'Baseline\nGaze\nController\nHand tracking';
    }
    if (participantInput) participantInput.value = '24';
    if (prefixInput) prefixInput.value = 'P';
    if (seedInput) seedInput.value = 'HCI-2026';
    const defaultMethod = document.querySelector<HTMLInputElement>(
      'input[name="design-method"][value="williams"]',
    );
    if (defaultMethod) defaultMethod.checked = true;
    document.querySelectorAll<HTMLElement>('.design-option').forEach((option) => {
      const input = option.querySelector<HTMLInputElement>('input');
      option.classList.toggle('is-selected', Boolean(input?.checked));
    });
    const plan = createPlan();
    if (plan) renderPlan(plan);
  };

  document
    .querySelectorAll<HTMLInputElement>('input[name="design-method"]')
    .forEach((input) => {
      input.addEventListener('change', () => {
        document
          .querySelectorAll<HTMLElement>('.design-option')
          .forEach((option) => {
            const optionInput = option.querySelector<HTMLInputElement>('input');
            option.classList.toggle(
              'is-selected',
              Boolean(optionInput?.checked),
            );
          });
        const plan = createPlan();
        if (plan) renderPlan(plan);
      });
    });

  generateButton?.addEventListener('click', () => {
    const plan = createPlan();
    if (plan) renderPlan(plan);
  });
  resetButton?.addEventListener('click', resetPlanner);
  newSeedButton?.addEventListener('click', generateNewSeed);
  copyButton?.addEventListener('click', copyPlan);
  downloadButton?.addEventListener('click', downloadCsv);
  document
    .querySelector<HTMLElement>('#participant-suggestion-actions')
    ?.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
        'button[data-participant-count]',
      );
      const suggestedCount = Number(target?.dataset.participantCount);
      if (!target || !Number.isInteger(suggestedCount) || !participantInput) {
        return;
      }
      participantInput.value = String(suggestedCount);
      const plan = createPlan();
      if (plan) renderPlan(plan);
      participantInput.focus();
    });

  const initialPlan = createPlan();
  if (initialPlan) renderPlan(initialPlan);
</script>

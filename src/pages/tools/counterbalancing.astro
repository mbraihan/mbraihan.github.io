    white-space: nowrap;
  }

  .method-panel {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent-blue);
  }

  .method-panel > svg {

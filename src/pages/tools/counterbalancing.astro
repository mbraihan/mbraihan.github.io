    white-space: nowrap;
  }

  :global(.condition-sequence) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  :global(.condition-sequence span) {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.36rem;
    border: 1px solid var(--border-color);
    border-radius: 3px;
    background: var(--bg-pill);
    color: var(--text-main);

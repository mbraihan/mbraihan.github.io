<script>
  // User-controlled carousel logic with robust event delegation
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = carousel.querySelectorAll('.carousel-slide');
    if (slides.length === 0) return;

    let currentIndex = 0;

    function showSlide(index: number) {
      slides.forEach((slide, idx) => {
        slide.classList.toggle('active', idx === index);
      });
      carousel.querySelectorAll('.carousel-dot').forEach((dot, idx) => {
        dot.classList.toggle('active', idx === index);
      });
      const counter = carousel.querySelector('.carousel-counter');
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    }

    // Event delegation: listens for clicks anywhere inside carousel
    carousel.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const prevBtn = target.closest('.prev-btn');
      const nextBtn = target.closest('.next-btn');
      const dot = target.closest('.carousel-dot');

      if (prevBtn) {
        e.preventDefault();
        e.stopPropagation();
        currentIndex = (currentIndex - 1 + slides.length) % slides.length;
        showSlide(currentIndex);
      } else if (nextBtn) {
        e.preventDefault();
        e.stopPropagation();
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      } else if (dot) {
        e.preventDefault();
        const dotIndex = Number((dot as HTMLElement).dataset.dotIndex);
        if (Number.isInteger(dotIndex)) {
          currentIndex = dotIndex;
          showSlide(currentIndex);
        }
      }
    });

    if (slides.length < 2) {
      carousel.querySelectorAll('.carousel-controls-bar').forEach((bar) => {
        bar.classList.add('hidden');
      });
    }
  });

  // Copy BibTeX
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-bib');
      if (textToCopy) {
        await navigator.clipboard.writeText(textToCopy);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const copyText = btn.querySelector('.copy-text');

        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (copyText) copyText.textContent = 'Copied!';

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      }
    });
  });
</script>

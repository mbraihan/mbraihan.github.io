---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { 
  FileText, Github, ExternalLink, Copy, Check, ChevronLeft, ChevronRight, Database, BookOpen, Layers, Video, ArrowLeft, ArrowRight
} from 'lucide-astro';
import LoopingPreviewVideo from '../../components/LoopingPreviewVideo.astro';
import {
  getPublicationPresentationVideo,
  getPublicationPreviewVideo,
  getPublicationTeaserImage,
  shouldContainPublicationMedia,
  shouldShowRelatedWork,
} from '../../data/publicationMedia';
import { getAuthorLink, getAuthorAffiliation } from '../../data/authorLinks';
import { getInstitutionLogo } from '../../data/institutions';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({
    params: { id: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { data, id } = pub;
const { Content } = await render(pub);
const previewVideo = getPublicationPreviewVideo(id);
const teaserImage = getPublicationTeaserImage(id) || data.image;
const rawPresentation = data.presentationVideo || data.presentation;
const presentationVideo = rawPresentation
  ? {
      url: rawPresentation,
      embedUrl: rawPresentation.includes('embed')
        ? rawPresentation
        : `https://www.youtube-nocookie.com/embed/${rawPresentation.includes('v=') ? rawPresentation.split('v=')[1].split('&')[0] : rawPresentation.split('/').pop()}?rel=0`,
    }
  : getPublicationPresentationVideo(id);
const containMedia = shouldContainPublicationMedia(id);
const showRelatedWork = shouldShowRelatedWork(id);

// Author Link & Affiliation Superscript Processing
const uniqueAffiliations: string[] = [];
const authorAffilMap = data.authors.map((authorName) => {
  const affil = getAuthorAffiliation(authorName) || 'Affiliation not added yet';
  let affilIndex = uniqueAffiliations.indexOf(affil);
  if (affilIndex === -1) {
    uniqueAffiliations.push(affil);
    affilIndex = uniqueAffiliations.length - 1;
  }
  return {
    name: authorName,
    link: getAuthorLink(authorName),
    affilNum: affilIndex + 1,
  };
});

// Fetch all publications for related work section
const allPubs = await getCollection('publications');
const relatedPubs = data.relatedPaperIds && data.relatedPaperIds.length > 0
  ? allPubs.filter((p) => data.relatedPaperIds!.includes(p.id))
  : allPubs.filter((p) => p.id !== id).slice(0, 3);

const affiliationEntries = uniqueAffiliations.map((name, idx) => ({
  name,
  index: idx + 1,
  logo: getInstitutionLogo(name),
}));
const showInstitutionLogos = affiliationEntries.length === 3 && affiliationEntries.every((entry) => entry.logo);
const venueUrl = data.website || data.doi;
const venueDisplay = (() => {
  if (id === 'vergence-accommodation-gaze-selection') return 'ISMAR, 2026';
  if (!data.venueShort) return `${data.venue}, ${data.year}`;

  const shortVenue = data.venueShort.replace(/\s+(19|20)\d{2}$|\s+\d{2}$/, '').trim();
  return `${shortVenue}, ${data.year}`;
})();
const publicationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: data.title,
  description: data.abstract || data.title,
  datePublished: `${data.year}-01-01`,
  url: new URL(`/publications/${id}`, 'https://mbraihan.github.io').href,
  isPartOf: {
    '@type': data.type === 'Journal' ? 'Periodical' : 'PublicationIssue',
    name: data.venue,
  },
  author: data.authors.map((name) => ({
    '@type': 'Person',
    name,
    ...(getAuthorLink(name) ? { sameAs: getAuthorLink(name) } : {}),
  })),
};
---

<BaseLayout 
  title={`${data.title} | Mohammad Raihanul Bashar`}
  description={data.abstract || data.title}
  type="article"
  structuredData={publicationStructuredData}
>
  <article class="paper-page-container">
    <!-- Top Left Back Button -->
    <div class="top-nav-bar-row">
      <a href="/publications" class="back-to-pubs-btn">
        <ArrowLeft size={16} />
        <span>Back to Publications</span>
      </a>
    </div>

    <!-- Header Hero Area -->
    <header class="paper-header">
      <h1 class="paper-title">{data.title}</h1>

      {data.type === 'Workshop' && (
        <div class="paper-type-label">Workshop Paper</div>
      )}

      <!-- Author Hyperlinks and Organization Superscripts -->
      <div class="paper-authors">
        {authorAffilMap.map((author, idx) => (
          <span class="author-span">
            {author.link ? (
              <a href={author.link} target="_blank" rel="noopener noreferrer" class="author-link">
                {author.name}<sup>{author.affilNum}</sup>
              </a>
            ) : (
              <span class="author-name">{author.name}<sup>{author.affilNum}</sup></span>
            )}
            {idx < authorAffilMap.length - 1 ? ', ' : ''}
          </span>
        ))}
      </div>

      <!-- Author Organizations & Affiliations List -->
      <div class="author-affiliations">
        {uniqueAffiliations.map((affil, idx) => (
          <span class="affiliation-item">
            <sup>{idx + 1}</sup> {affil}{idx < uniqueAffiliations.length - 1 ? '   •   ' : ''}
          </span>
        ))}
      </div>

      {showInstitutionLogos && (
        <div class="institution-logos" aria-label="Author institutions">
          {affiliationEntries.map((institution) => (
            <div class="institution-logo-item">
              <img
                src={institution.logo!}
                alt={`${institution.name} logo`}
                class="institution-logo"
                width="96"
                height="42"
                loading="eager"
                decoding="async"
              />
            </div>
          ))}
        </div>
      )}

      <div class="venue-badge-wrapper">
        {venueUrl ? (
          <a href={venueUrl} target="_blank" rel="noopener noreferrer" class="venue-badge venue-link">
            <span>{venueDisplay}</span>
          </a>
        ) : (
          <span class="venue-badge">
            <span>{venueDisplay}</span>
          </span>
        )}
      </div>

      {data.correspondingAuthor && (
        <p class="corresponding-note">Corresponding author: {data.correspondingAuthor}</p>
      )}

      <!-- Action Chips Buttons (Dark Pills with Vibrant Icons) -->
      <div class="action-buttons-group">
        {data.pdf && (
          <a href={data.pdf} target="_blank" rel="noopener noreferrer" class="chip-btn chip-pdf" aria-label="Paper PDF">
            <FileText size={16} class="chip-icon" />
            <span>Paper</span>
          </a>
        )}
        {data.arxiv && (
          <a href={data.arxiv} target="_blank" rel="noopener noreferrer" class="chip-btn chip-arxiv" aria-label="arXiv preprint">
            <BookOpen size={16} class="chip-icon" />
            <span>arXiv</span>
          </a>
        )}
        {data.video && (
          <a
            href={data.video}
            target="_blank"
            rel="noopener noreferrer"
            class="chip-btn chip-video"
            aria-label="Teaser Video"
          >
            <Video size={16} class="chip-icon" />
            <span>Video</span>
          </a>
        )}
        {data.github && (
          <a href={data.github} target="_blank" rel="noopener noreferrer" class="chip-btn chip-github" aria-label="GitHub Code">
            <Github size={16} class="chip-icon" />
            <span>Code</span>
          </a>
        )}
        {data.data && (
          <a href={data.data} target="_blank" rel="noopener noreferrer" class="chip-btn chip-data" aria-label="Dataset">
            <Database size={16} class="chip-icon" />
            <span>Data</span>
          </a>
        )}
        {data.poster && (
          <a href={data.poster} target="_blank" rel="noopener noreferrer" class="chip-btn chip-poster" aria-label="Poster">
            <FileText size={16} class="chip-icon" />
            <span>Poster</span>
          </a>
        )}
        {data.doi && (
          <a href={data.doi} target="_blank" rel="noopener noreferrer" class="chip-btn chip-doi" aria-label="DOI publication link">
            <ExternalLink size={16} class="chip-icon" />
            <span>DOI</span>
          </a>
        )}
      </div>

      <!-- Hero Banner Media -->
      {(teaserImage || previewVideo) && (
        <div class:list={[
          'hero-banner-wrapper',
          {
            'has-looping-video': !teaserImage && previewVideo,
            'has-contained-media': containMedia,
          },
        ]}>
          {teaserImage ? (
            <img src={teaserImage} alt={`${data.title} teaser`} class="hero-banner-img" />
          ) : (
            <LoopingPreviewVideo
              src={previewVideo}
              className="hero-banner-img"
              label={`Looping preview of ${data.title}`}
            />
          )}
          {data.bannerCaption && (
            <p class="hero-banner-caption">{data.bannerCaption}</p>
          )}
        </div>
      )}
    </header>

    <hr class="section-divider" />

    <!-- Abstract Section -->
    {data.abstract && (
      <section class="paper-section abstract-section">
        <h2 class="section-heading text-center">Abstract</h2>
        <div class="abstract-text">
          <p>{data.abstract}</p>
        </div>
      </section>
    )}

    <!-- Methodology Section -->
    {(data.methodologyText || (data.methodologyImages && data.methodologyImages.length > 0) || (data.methodologyVideos && data.methodologyVideos.length > 0)) && (
      <section class="paper-section methodology-section">
        <h2 class="section-heading">Methodology</h2>
        
        {data.methodologyText && (
          <div class="methodology-intro">
            <p>{data.methodologyText}</p>
          </div>
        )}

        {data.methodologyImages && data.methodologyImages.length > 0 && (
          <div class="methodology-grid">
            <div class="media-column">
              {data.methodologyImages.length === 1 ? (
                <div class="figure-box">
                  <img src={data.methodologyImages[0]} alt={data.methodologyCaptions?.[0] || "Methodology diagram"} class="figure-img" />
                  {data.methodologyCaptions?.[0] && (
                    <p class="figure-caption">{data.methodologyCaptions[0]}</p>
                  )}
                </div>
              ) : (
                /* Carousel slider for multiple images */
                <div class="carousel-container" data-carousel="methodology">
                  <button class="carousel-control-btn prev-btn" aria-label="Previous slide" title="Previous slide">
                    <ChevronLeft size={20} />
                  </button>

                <div class="carousel-slides">
                    {data.methodologyImages.map((img, idx) => (
                      <div class={`carousel-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>
                        <div class="carousel-img-wrapper">
                          <img src={img} alt={data.methodologyCaptions?.[idx] || `Methodology figure ${idx + 1}`} class="figure-img" />
                        </div>
                        {data.methodologyCaptions?.[idx] && (
                          <p class="carousel-caption">{data.methodologyCaptions[idx]}</p>
                        )}
                      </div>
                    ))}
                  </div>

                  <button class="carousel-control-btn next-btn" aria-label="Next slide" title="Next slide">
                    <ChevronRight size={20} />
                  </button>

                  <div class="carousel-pagination" aria-label="Figure selection">
                    <div class="carousel-dots">
                    {data.methodologyImages.map((_, idx) => (
                      <button class={`carousel-dot ${idx === 0 ? 'active' : ''}`} data-dot-index={idx} aria-label={`Go to slide ${idx + 1}`}></button>
                    ))}
                    </div>
                    <span class="carousel-counter">1 / {data.methodologyImages.length}</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {data.methodologyVideos && data.methodologyVideos.length > 0 && (
          <div class="methodology-videos-grid">
            {data.methodologyVideos.map((vid) => (
              <div class="methodology-video-card">
                <h3 class="methodology-video-title">{vid.title}</h3>
                <div class="methodology-video-wrapper">
                  <iframe
                    src={vid.embedSrc}
                    style="height: auto; width: 100%; aspect-ratio: 640 / 360;"
                    allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
                    allowfullscreen
                    frameborder="0"
                    loading="lazy"
                    title={`${vid.title} demo video`}
                  ></iframe>
                </div>
                {vid.description && (
                  <p class="methodology-video-desc">{vid.description}</p>
                )}
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- Results Section -->
    {(data.resultsText || (data.resultsImages && data.resultsImages.length > 0)) && (
      <section class="paper-section results-section">
        <h2 class="section-heading">Results</h2>

        <div class="results-grid">
          {data.resultsText && (
            <div class="text-column">
              <p>{data.resultsText}</p>
            </div>
          )}

          {data.resultsImages && data.resultsImages.length > 0 && (
            <div class="media-column">
              {data.resultsImages.length === 1 ? (
                <div class="figure-box">
                  <img src={data.resultsImages[0]} alt={data.resultsCaptions?.[0] || "Results chart"} class="figure-img" />
                  {data.resultsCaptions?.[0] && (
                    <p class="figure-caption">{data.resultsCaptions[0]}</p>
                  )}
                </div>
              ) : (
                /* Carousel slider for multiple results charts */
                <div class="carousel-container" data-carousel="results">
                  <button class="carousel-control-btn prev-btn" aria-label="Previous slide" title="Previous slide">
                    <ChevronLeft size={20} />
                  </button>

                  <div class="carousel-slides">
                    {data.resultsImages.map((img, idx) => (
                      <div class={`carousel-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>
                        <div class="carousel-img-wrapper">
                          <img src={img} alt={data.resultsCaptions?.[idx] || `Results chart ${idx + 1}`} class="figure-img" />
                        </div>
                        {data.resultsCaptions?.[idx] && (
                          <p class="carousel-caption">{data.resultsCaptions[idx]}</p>
                        )}
                      </div>
                    ))}
                  </div>

                  <button class="carousel-control-btn next-btn" aria-label="Next slide" title="Next slide">
                    <ChevronRight size={20} />
                  </button>

                  <div class="carousel-pagination" aria-label="Figure selection">
                    <div class="carousel-dots">
                    {data.resultsImages.map((_, idx) => (
                      <button class={`carousel-dot ${idx === 0 ? 'active' : ''}`} data-dot-index={idx} aria-label={`Go to slide ${idx + 1}`}></button>
                    ))}
                    </div>
                    <span class="carousel-counter">1 / {data.resultsImages.length}</span>
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Poster Section -->
    {data.poster && (
      <section class="paper-section poster-section">
        <h2 class="section-heading">Poster</h2>
        <div class="poster-container">
          <a href={data.poster} target="_blank" rel="noopener noreferrer" class="poster-link" title="Click to view full-resolution poster">
            <img src={data.poster} alt={`${data.title} poster`} class="poster-img" loading="lazy" decoding="async" />
          </a>
        </div>
      </section>
    )}

    <!-- Presentation Video -->
    {presentationVideo && (
      <section class="paper-section presentation-section">
        <h2 class="section-heading">Presentation</h2>
        <div class="presentation-video">
          <iframe
            src={presentationVideo.embedUrl}
            title={`${data.title} presentation`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    )}

    <!-- Application & Implications / Design Guidelines Section -->
    {(data.applicationText || data.designGuidelines) && (
      <section class="paper-section application-section">
        <h2 class="section-heading">Application & Implications</h2>

        <div class="application-grid">
          {data.applicationVideo && (
            <div class="media-column">
              <div class="video-preview-box">
                <img src={data.applicationVideo} alt="Application scenario" class="figure-img" />
              </div>
            </div>
          )}

          <div class="text-column">
            {data.applicationText && <p>{data.applicationText}</p>}

            {data.designGuidelines && data.designGuidelines.length > 0 && (
              <div class="guidelines-block">
                <h3 class="sub-heading">Design Guidelines:</h3>
                <ul class="guidelines-list">
                  {data.designGuidelines.map((guideline) => (
                    <li>{guideline}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Related Work Section -->
    {showRelatedWork && relatedPubs.length > 0 && (
      <section class="paper-section related-section">
        <h2 class="section-heading">Related Work / Research</h2>
        <div class="related-research-list">
          {relatedPubs.map((rel) => (
            <a href={`/publications/${rel.id}`} class="related-research-link">
              <span class="related-research-title">{rel.data.title}</span>
              <span class="related-research-venue">
                {rel.data.venueShort || rel.data.venue}
              </span>
              <ArrowRight size={16} class="related-research-arrow" />
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- BibTeX Section -->
    {data.bibtex && (
      <section class="paper-section bibtex-section">
        <h2 class="section-heading">BibTeX</h2>

        <div class="bibtex-paper-box">
          <button class="copy-btn" data-bib={data.bibtex}>
            <Copy size={13} class="copy-icon" />
            <Check size={13} class="check-icon hidden" />
            <span class="copy-text">Copy</span>
          </button>
          <pre><code>{data.bibtex}</code></pre>
        </div>
      </section>
    )}

    <!-- Footer Template Notice -->
    <footer class="paper-footer-notice">
      <p>This page was built using the <a href="https://github.com/nerfies/nerfies.github.io" target="_blank" rel="noopener noreferrer" class="template-link">Academic Project Page Template</a> and adapted from the <a href="https://nerfies.github.io/" target="_blank" rel="noopener noreferrer" class="template-link">Nerfies</a> project page.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .paper-page-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem 1.5rem;
    font-family: var(--font-noto-sans);
  }

  .paper-page-container :where(h2, h3, h4, h5, h6, p, section, span, button, a, div, footer, li) {
    font-family: var(--font-noto-sans);
  }

  /* Header Hero */
  .paper-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .top-nav-bar-row {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 1.25rem;
  }

  .back-to-pubs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background: var(--bg-card);
    transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .back-to-pubs-btn:hover {
    color: var(--accent-blue);
    border-color: var(--accent-blue-border);
    transform: translateX(-2px);
  }

  .venue-badge-wrapper {
    display: flex;
    justify-content: center;
    margin: 1.25rem 0 1rem;
  }

  .venue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-md);
    background-color: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: var(--font-noto-sans);
  }

  .venue-label {
    color: var(--text-subtle);
    font-weight: 500;
  }

  .venue-link:hover {
    border-color: var(--accent-blue);
    background-color: var(--accent-blue-light);
  }

  :global([data-theme='dark']) .venue-badge {
    background-color: rgba(37, 99, 235, 0.2);
    color: #60a5fa;
    border-color: rgba(59, 130, 246, 0.3);
  }

  /* Google Sans for Main paper title, author names, and teaser sentence */
  .paper-title {
    font-family: var(--font-google-sans) !important;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .paper-type-label {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.7rem;
    margin: -0.45rem 0 0.9rem;
    border-radius: var(--radius-full);
    background: var(--accent-blue-light);
    border: 1px solid var(--accent-blue-border);
    color: var(--accent-blue);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .paper-authors,
  .paper-authors span,
  .paper-authors a,
  .author-primary {
    font-family: var(--font-google-sans) !important;
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .author-link {
    color: var(--accent-blue);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .author-name {
    color: var(--text-muted);
  }

  .author-affiliations {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.7rem;
    max-width: 850px;
    margin: 0 auto 0.75rem;
    color: var(--text-subtle);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .affiliation-item sup {
    color: var(--accent-blue);
    font-weight: 700;
  }

  .institution-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 0.9rem auto 0;
  }

  .institution-logo-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 9rem;
    height: 3.75rem;
  }

  .institution-logo {
    display: block;
    width: 8.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: 0.35rem;
    background: #ffffff;
    border: 1px solid var(--border-color);
    padding: 0.18rem;
    line-height: 0;
  }

  .author-primary {
    color: var(--accent-blue);
    text-decoration: underline;
    font-weight: 600;
  }

  .institution-name {
    font-family: var(--font-noto-sans) !important;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .corresponding-note {
    font-family: var(--font-noto-sans) !important;
    font-size: 0.82rem;
    color: var(--text-subtle);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  /* Action Chips - Modern Refined Design */
  .action-buttons-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2.5rem;
  }

  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.2;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .chip-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .chip-icon {
